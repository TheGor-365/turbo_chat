<div id="pager" class="sd-history-pager">
  <% if pagy.next %>
    <%= link_to url_for(page: pagy.next),
      class: "sd-history-more",
      title: t("ui.message_search.load_earlier"),
      aria: { label: t("ui.message_search.load_earlier") },
      data: { turbo_frame: "page_handler" } do %>
      <%= sd_icon("chevron-up", size: 20) %>
      <span class="sd-visually-hidden"><%= t("ui.message_search.load_earlier") %></span>
    <% end %>
  <% end %>
</div>
