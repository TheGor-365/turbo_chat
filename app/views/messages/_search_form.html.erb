<div class="message-search-shell sd-command" data-controller="message-search"
     data-message-search-url-value="<%= search_room_messages_path(room) %>"
     data-action="keydown.ctrl+k@window->message-search#shortcut keydown.meta+k@window->message-search#shortcut">
  <button type="button" class="sd-command-trigger sd-icon-button"
          data-message-search-target="openButton" data-action="click->message-search#open"
          aria-label="<%= t("ui.message_search.search") %>" aria-controls="message-search-panel" aria-expanded="false"
          title="<%= t("ui.message_search.open_hint") %>">
    <%= sd_icon("search", size: 18) %>
    <span class="sd-visually-hidden"><%= t("ui.message_search.find") %></span>
  </button>
  <div id="message-search-panel" class="sd-command-panel" data-message-search-target="panel" hidden>
    <%= form_with url: search_room_messages_path(room), method: :get,
      class: "message-search-form sd-command-form", role: "search",
      data: { turbo_frame: "message_search_results", action: "submit->message-search#submit" } do |form| %>
      <%= form.label :q, t("ui.message_search.search"), class: "sd-visually-hidden" %>
      <%= form.search_field :q, class: "sd-command-input",
        placeholder: t("ui.message_search.placeholder"), maxlength: 100,
        autocomplete: "off", aria: { label: t("ui.message_search.search"), controls: "message_search_results" },
        data: { message_search_target: "input", action: "input->message-search#changed keydown.esc->message-search#close" } %>
      <button type="button" class="sd-command-close sd-icon-button"
              data-message-search-target="closeButton" data-action="click->message-search#close"
              aria-label="<%= t("ui.message_search.close") %>" title="<%= t("ui.message_search.close_hint") %>">
        <%= sd_icon("x", size: 17) %>
      </button>
    <% end %>
    <%= turbo_frame_tag "message_search_results", class: "message-search-results",
      data: { message_search_target: "results" }, hidden: true %>
  </div>
</div>
