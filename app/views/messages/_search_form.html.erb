<%= form_with url: search_room_messages_path(room), method: :get,
  class: "message-search-form", role: "search",
  data: { turbo_frame: "message_search_results" } do |form| %>
  <%= form.label :q, "Search messages", class: "visually-hidden" %>
  <%= form.search_field :q, class: "form-control form-control-sm",
    placeholder: "Find a message in this conversation", maxlength: 100,
    minlength: 2, required: true, aria: { label: "Search messages" } %>
  <%= form.submit "Search", class: "btn btn-sm btn-outline-light" %>
<% end %>
