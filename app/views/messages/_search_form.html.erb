<div class="message-search-shell" data-controller="message-search"
     data-message-search-url-value="<%= search_room_messages_path(room) %>">
  <%= form_with url: search_room_messages_path(room), method: :get,
    class: "message-search-form", role: "search",
    data: { turbo_frame: "message_search_results", action: "submit->message-search#submit" } do |form| %>
    <%= form.label :q, "Search messages", class: "visually-hidden" %>
    <%= form.search_field :q, class: "form-control form-control-sm",
      placeholder: "Search messages as you type…", maxlength: 100,
      autocomplete: "off", aria: { label: "Search messages", controls: "message_search_results" },
      data: { message_search_target: "input", action: "input->message-search#changed keydown.esc->message-search#clear" } %>
    <button type="button" class="btn btn-sm btn-outline-light message-search-dismiss"
            data-message-search-target="closeButton" data-action="click->message-search#clear"
            aria-label="Clear message search" hidden>Close</button>
  <% end %>
  <%= turbo_frame_tag "message_search_results", class: "message-search-results",
    data: { message_search_target: "results" }, hidden: true %>
</div>
