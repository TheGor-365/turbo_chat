<div class="p-3 cont-<%= message.user.id %>">
  <div class="message-box msg-<%= message.user.id %>">
    <div class="d-flex align-items-center">
      <% if message.user.avatar.attached? %>
        <%= image_tag(user_avatar_path(message.user), class: 'chat_pfp', alt: '') %>
      <% else %>
        <span class="chat_pfp avatar-fallback" aria-hidden="true"><%= message.user.email.first.upcase %></span>
      <% end %>
      <div>
        <h6 class="name"><%= message.user.email %></h6>
        <small><%= time_ago_in_words(message.created_at) %> ago</small>
      </div>
    </div>
    <div>
      <%= message.body %>
    </div>
    <% if message.attachments.attached? %>
      <% message.attachments.each_with_index do |attachment, index| %>
        <% if attachment.image? %>
          <%= image_tag chat_attachment_path(attachment), alt: attachment.filename.to_s, loading: "lazy" %>
        <% else %>
          <%= link_to attachment.filename.to_s, chat_attachment_path(attachment), download: attachment.filename.to_s %>
        <% end %>
      <% end %>
    <% end %>
  </div>
</div>
