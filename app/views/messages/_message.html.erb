<div class="p-3 cont-<%= message.user.id %>">
  <div class="message-box msg-<%= message.user.id %>">
    <div class="d-flex align-items-center">
      <%= image_tag(message.user.chat_thumbnail, class: 'chat_pfp', alt: '') %>
      <div>
        <h6 class="name"><%= message.user.email %></h6>
        <small><%= time_ago_in_words(message.created_at) %> ago</small>
      </div>
    </div>
    <div class="message-body"><%= simple_format(h(message.body)) if message.body.present? %></div>
    <% message.attachments.each do |attachment| %>
      <% url = room_message_attachment_path(message.room, message, attachment.id) %>
      <% if attachment.image? %>
        <%= link_to url, aria: { label: "Download #{attachment.filename}" } do %>
          <%= image_tag(url, alt: attachment.filename.to_s, loading: 'lazy', class: 'img-fluid rounded', style: 'max-height: 240px') %>
        <% end %>
      <% else %>
        <%= link_to attachment.filename.to_s, url, class: 'text-info' %>
      <% end %>
    <% end %>
  </div>
</div>
