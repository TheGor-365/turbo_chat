<div id="<%= dom_id(message) %>" class="sd-message cont-<%= message.user.id %>">
  <div class="message-box sd-message-bubble msg-<%= message.user.id %>">
    <div class="d-flex align-items-center">
      <% if message.user.avatar.attached? %>
        <%= image_tag(user_avatar_path(message.user), class: 'chat_pfp', alt: '') %>
      <% else %>
        <span class="chat_pfp avatar-fallback" aria-hidden="true" data-profile-initial-user-id="<%= message.user.id %>"><%= message.user.chat_label.first.upcase %></span>
      <% end %>
      <div>
        <h6 class="name" data-profile-label-user-id="<%= message.user.id %>"><%= message.user.chat_label %></h6>
        <small><%= time_ago_in_words(message.created_at) %> ago</small>
      </div>
    </div>
    <% if message.reply_to_id.present? %>
      <div class="message-quote" aria-label="Reply context">
        <% if message.reply_to && message.reply_to.room_id == message.room_id %>
          <a href="#message_<%= message.reply_to_id %>" class="message-quote-link">
            <strong data-profile-label-user-id="<%= message.reply_to.user.id %>"><%= message.reply_to.user.chat_label %></strong>
            <span><%= truncate(message.reply_to.body.presence || "Attachment", length: 110) %></span>
          </a>
        <% else %>
          <span class="text-white-50">Original message unavailable</span>
        <% end %>
      </div>
    <% end %>
    <div>
      <%= message.body %>
    </div>
    <div class="sd-message-actions" aria-label="Message actions">
      <button type="button" class="sd-icon-button sd-quiet-action sd-message-action"
        data-reply-message-id="<%= message.id %>"
        data-reply-author="<%= message.user.chat_label %>"
        data-profile-reply-user-id="<%= message.user.id %>"
        data-reply-preview="<%= truncate(message.body.presence || "Attachment", length: 110) %>"
        title="Reply" aria-label="Reply to message from <%= message.user.chat_label %>">
        <%= sd_icon("reply", size: 17) %><span class="sd-visually-hidden">Reply</span>
      </button>
    <% if local_assigns[:viewer]&.id == message.user_id %>
        <%= link_to edit_room_message_path(message.room, message),
          class: "sd-icon-button sd-quiet-action sd-message-action", title: "Edit",
          aria: { label: "Edit" }, data: { turbo: false } do %>
          <%= sd_icon("pencil", size: 17) %><span class="sd-visually-hidden">Edit</span>
        <% end %>
        <%= button_to room_message_path(message.room, message), method: :delete,
          class: "sd-icon-button sd-quiet-action sd-message-action sd-danger-action",
          title: "Delete", aria: { label: "Delete" },
          form: { data: { turbo_confirm: "Delete this message?" } } do %>
          <%= sd_icon("trash", size: 17) %><span class="sd-visually-hidden">Delete</span>
        <% end %>
    <% end %>
    </div>
    <%# Deliberately small functional controls. A complete design system is planned. %>
    <% if local_assigns[:viewer] %>
      <% grouped_reactions = message.message_reactions.to_a.group_by(&:emoji) %>
      <div class="message-reactions" aria-label="Message reactions">
        <% grouped_reactions.each do |emoji, entries| %>
          <% own_reaction = entries.find { |entry| entry.user_id == viewer.id } %>
          <% if own_reaction %>
            <%= button_to room_message_reaction_path(message.room, message, own_reaction),
              method: :delete, class: "reaction-chip reaction-chip-active",
              aria: { label: "Remove #{emoji} reaction" } do %>
              <span aria-hidden="true"><%= emoji %></span> <span><%= entries.size %></span>
            <% end %>
          <% else %>
            <%= button_to room_message_reactions_path(message.room, message),
              method: :post, params: { reaction: { emoji: emoji } },
              class: "reaction-chip", aria: { label: "React #{emoji}" } do %>
              <span aria-hidden="true"><%= emoji %></span> <span><%= entries.size %></span>
            <% end %>
          <% end %>
        <% end %>
        <details class="reaction-picker">
          <summary class="sd-icon-button sd-quiet-action sd-message-action" aria-label="Choose a reaction" title="React">
            <%= sd_icon("smile", size: 18) %><span class="sd-visually-hidden">React</span>
          </summary>
          <div class="reaction-options" aria-label="Available reactions">
            <% MessageReaction::EMOJIS.each do |emoji| %>
              <%= button_to emoji, room_message_reactions_path(message.room, message),
                method: :post, params: { reaction: { emoji: emoji } },
                class: "reaction-option", aria: { label: "React #{emoji}" } %>
            <% end %>
          </div>
        </details>
      </div>
    <% end %>
    <% if message.attachments.attached? %>
      <% message.attachments.each_with_index do |attachment, index| %>
        <% if attachment.blob.content_type == "video/webm" &&
              attachment.filename.to_s.downcase.end_with?(".webm") &&
              !attachment.filename.to_s.downcase.start_with?("voice") %>
          <div class="video-message">
            <video controls playsinline preload="none" aria-label="Video clip from <%= message.user.chat_label %>" data-profile-media-user-id="<%= message.user.id %>" data-profile-media-kind="video">
              <source src="<%= chat_attachment_path(attachment) %>" type="video/webm">
              Your browser cannot play WebM/VP8 video.
            </video>
          </div>
        <% elsif %w[audio/webm video/webm].include?(attachment.blob.content_type) &&
              attachment.filename.to_s.downcase.end_with?(".webm") %>
          <div class="voice-message">
            <span class="visually-hidden">Voice message</span>
            <audio controls preload="none" aria-label="Voice message from <%= message.user.chat_label %>" data-profile-media-user-id="<%= message.user.id %>" data-profile-media-kind="audio">
              <source src="<%= chat_attachment_path(attachment) %>" type="audio/webm">
              Your browser cannot play WebM/Opus audio.
            </audio>
          </div>
        <% elsif attachment.image? %>
          <%= image_tag chat_attachment_path(attachment), alt: attachment.filename.to_s, loading: "lazy" %>
        <% else %>
          <%= link_to attachment.filename.to_s, chat_attachment_path(attachment), download: attachment.filename.to_s %>
        <% end %>
      <% end %>
    <% end %>
  </div>
</div>
