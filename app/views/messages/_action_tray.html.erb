<%# Action dock and reaction counts remain siblings of the message bubble. %>
<div class="sd-message-extras">
  <% if viewer %>
    <% grouped_reactions = message.message_reactions.to_a.group_by(&:emoji) %>
    <% if grouped_reactions.any? %>
      <div class="message-reactions" aria-label="<%= t("ui.chat_messages.message_reactions") %>">
        <% grouped_reactions.each do |emoji, entries| %>
          <% own_reaction = entries.find { |entry| entry.user_id == viewer.id } %>
          <% if own_reaction %>
            <%= button_to room_message_reaction_path(message.room, message, own_reaction),
              method: :delete, class: "reaction-chip reaction-chip-active",
              aria: { label: t("ui.chat_messages.remove_reaction", emoji: emoji) } do %>
              <span aria-hidden="true"><%= emoji %></span> <span><%= entries.size %></span>
            <% end %>
          <% else %>
            <%= button_to room_message_reactions_path(message.room, message),
              method: :post, params: { reaction: { emoji: emoji } },
              class: "reaction-chip", aria: { label: t("ui.chat_messages.react_emoji", emoji: emoji) } do %>
              <span aria-hidden="true"><%= emoji %></span> <span><%= entries.size %></span>
            <% end %>
          <% end %>
        <% end %>
      </div>
    <% end %>
  <% end %>
  <div class="sd-message-toolbar">
    <button type="button" class="sd-icon-button sd-quiet-action sd-message-action-trigger"
      data-message-actions-target="trigger" data-action="message-actions#toggle"
      aria-controls="message_actions_<%= message.id %>" aria-expanded="false"
      title="<%= t("ui.chat_messages.actions") %>" aria-label="<%= t("ui.chat_messages.actions") %>">
      <%= sd_icon("chevron-down", size: 18) %>
    </button>
    <div id="message_actions_<%= message.id %>" class="sd-message-actions"
      data-message-actions-target="panel" data-action="click->message-actions#actionSelected"
      role="group" aria-label="<%= t("ui.chat_messages.actions") %>" hidden>
      <button type="button" class="sd-icon-button sd-quiet-action sd-message-action"
        data-reply-message-id="<%= message.id %>"
        data-reply-author="<%= message.user.chat_label %>"
        data-profile-reply-user-id="<%= message.user.id %>"
        data-reply-preview="<%= truncate(message.body.presence || t("ui.chat_messages.attachment"), length: 110) %>"
        title="<%= t("ui.chat_messages.reply") %>" aria-label="<%= t("ui.chat_messages.reply_from", name: message.user.chat_label) %>">
        <%= sd_icon("reply", size: 18) %><span class="sd-visually-hidden"><%= t("ui.chat_messages.reply") %></span>
      </button>
      <% if viewer %>
        <details class="reaction-picker">
          <summary class="sd-icon-button sd-quiet-action sd-message-action" aria-label="<%= t("ui.chat_messages.react") %>" title="<%= t("ui.chat_messages.react") %>">
            <%= sd_icon("smile", size: 18) %><span class="sd-visually-hidden"><%= t("ui.chat_messages.react") %></span>
          </summary>
          <div class="reaction-options" aria-label="<%= t("ui.chat_messages.available_reactions") %>">
            <% MessageReaction::EMOJIS.each do |emoji| %>
              <%= button_to emoji, room_message_reactions_path(message.room, message),
                method: :post, params: { reaction: { emoji: emoji } },
                class: "reaction-option", aria: { label: t("ui.chat_messages.react_emoji", emoji: emoji) } %>
            <% end %>
          </div>
        </details>
      <% end %>
      <% if viewer&.id == message.user_id %>
        <%= link_to edit_room_message_path(message.room, message),
          class: "sd-icon-button sd-quiet-action sd-message-action", title: t("ui.chat_messages.edit"),
          aria: { label: t("ui.chat_messages.edit") }, data: { turbo: false } do %>
          <%= sd_icon("pencil", size: 18) %><span class="sd-visually-hidden"><%= t("ui.chat_messages.edit") %></span>
        <% end %>
        <%= button_to room_message_path(message.room, message), method: :delete,
          class: "sd-icon-button sd-quiet-action sd-message-action sd-danger-action",
          title: t("ui.chat_messages.delete"), aria: { label: t("ui.chat_messages.delete") },
          form: { data: { turbo_confirm: t("ui.chat_messages.confirm_delete") } } do %>
          <%= sd_icon("trash", size: 18) %><span class="sd-visually-hidden"><%= t("ui.chat_messages.delete") %></span>
        <% end %>
      <% end %>
    </div>
  </div>
</div>
