<section id="ai-workspace" class="sd-ai-page" aria-labelledby="ai-workspace-title">
  <header class="sd-ai-header">
    <div class="sd-ai-header__identity">
      <span class="sd-ai-eyebrow"><%= sd_icon("sparkles", size: 16) %> ROOM-LOCAL AI WORKSPACE</span>
      <h1 id="ai-workspace-title">AI Workspace</h1>
      <p>
        <%= sd_icon(@room.private_group? ? "lock" : (@room.direct_message? ? "user" : "globe"), size: 16) %>
        <span><%= @conversation_label %></span>
      </p>
    </div>
    <%= link_to room_path(@room), class: "sd-ai-back", title: "Back to conversation",
      aria: { label: "Back to conversation" } do %>
      <%= sd_icon("arrow-left", size: 19) %>
    <% end %>
  </header>

  <div class="sd-ai-status" role="status">
    <span class="sd-ai-status__icon"><%= sd_icon("shield", size: 22) %></span>
    <div>
      <% if @semantic_tasks_enabled %>
        <strong>Optional paid generation available</strong>
        <p>Client Brief and other contextual tasks start only from the conversation editor after all participants opt in and the author confirms one billable request. Nothing is generated or sent automatically.</p>
      <% else %>
        <strong>External AI is not configured</strong>
        <p>No xAI request can be made from this page. Automatic local Client Brief remains available without API charges or sending messages.</p>
      <% end %>
    </div>
    <span class="sd-ai-state"><%= @semantic_tasks_enabled ? "Opt-in" : "Offline" %></span>
  </div>

  <% if @room.is_private? %>
    <nav class="sd-ai-tools" aria-label="AI workspace tools">
      <%= link_to new_room_ai_deliverable_review_path(@room),
        class: "sd-ai-tool-link", title: "Open automatically prepared Client Brief for source review",
        aria: { label: "Open structured manual review" } do %>
        <span class="sd-ai-tool-link__icon"><%= sd_icon("check-check", size: 19) %></span>
        <span class="sd-ai-tool-link__copy">
          <strong>Automatic Client Brief</strong>
          <small>No Grok · Review sources · Optional edits</small>
        </span>
        <%= sd_icon("arrow-up-right", size: 18) %>
      <% end %>
      <%= link_to room_path(@room), class: "sd-ai-tool-link",
        title: "Return to conversation to open writing assistant",
        aria: { label: "Open conversation for optional contextual generation" } do %>
        <span class="sd-ai-tool-link__icon"><%= sd_icon("sparkles", size: 19) %></span>
        <span class="sd-ai-tool-link__copy">
          <strong>Semantic AI · optional paid request</strong>
          <small><%= @semantic_tasks_enabled ? "Open editor · Choose Client brief · Confirm one request (up to $0.10 reserved)" : "Unavailable until xAI, permissions and budget are configured" %></small>
        </span>
        <%= sd_icon("arrow-up-right", size: 18) %>
      <% end %>
    </nav>
  <% end %>

  <div class="sd-ai-grid">
    <section class="sd-ai-scope" aria-labelledby="ai-scope-heading">
      <div class="sd-ai-section-heading">
        <%= sd_icon("messages", size: 19) %>
        <div>
          <h2 id="ai-scope-heading">Choose exactly what AI could see</h2>
          <p>Text only · up to 8 individual messages · no automatic history or attachments.</p>
        </div>
      </div>
      <%= form_with url: preview_room_ai_workspace_path(@room), method: :post, scope: :review,
        local: true, data: { turbo: false }, class: "sd-ai-review-form" do |form| %>
        <div class="sd-ai-preset-controls" data-controller="ai-presets">
          <div class="sd-ai-preset-picker">
            <%= render "shared/signal_picker",
              id: "review_operation", name: "review[operation]",
              label: "Requested task", selected: @operation_for_form, icon: "messages",
              options: @operation_select_options,
              native_data: { ai_presets_target: "operation",
                action: "change->ai-presets#operationChanged" } %>
          </div>
          <div class="sd-ai-preset-picker">
            <%= render "shared/signal_picker",
              id: "review_preset_id", name: "review[preset_id]",
              label: "Built-in preset", selected: @chosen_preset_id, icon: "filter",
              options: @preset_select_options,
              native_data: { ai_presets_target: "preset",
                action: "change->ai-presets#presetChanged" } %>
            <p class="sd-ai-preset-hint" data-ai-presets-target="details" aria-live="polite">
              Fixed versioned rules · manual context · local preview only.
            </p>
          </div>
        </div>

        <div class="sd-ai-message-list" data-controller="ai-selection"
             data-ai-selection-max-value="<%= AiWorkspace::Scope::MAX_MESSAGES %>">
          <div class="sd-ai-message-list__heading">
            <span>Available recent messages</span>
            <span data-ai-selection-target="counter" aria-live="polite">0 / 8 selected</span>
          </div>
          <% if @candidate_messages.any? %>
            <% @candidate_messages.each do |message| %>
              <div class="sd-ai-message-choice">
                <%= check_box_tag "review[message_ids][]", message.id,
                  @selected_ids.include?(message.id), id: "ai-message-#{message.id}",
                  class: "sd-ai-choice-checkbox", data: { ai_selection_target: "checkbox",
                    action: "change->ai-selection#changed" } %>
                <%= label_tag "ai-message-#{message.id}", class: "sd-ai-message-choice__label" do %>
                  <span class="sd-ai-message-choice__meta">
                    <strong><%= message.user.chat_label %></strong>
                    <time datetime="<%= message.created_at.iso8601 %>">
                      <%= time_ago_in_words(message.created_at) %> ago
                    </time>
                  </span>
                  <span class="sd-ai-message-choice__text"><%= truncate(message.body, length: 160) %></span>
                <% end %>
              </div>
            <% end %>
          <% else %>
            <p class="sd-ai-empty">No text messages to select in this conversation.</p>
          <% end %>
        </div>

        <% if @review_error.present? %>
          <p class="sd-ai-error" role="alert"><%= @review_error %></p>
        <% end %>
        <div class="sd-ai-form-footer">
          <span><%= sd_icon("lock", size: 14) %> Review stays on this device's app session</span>
          <div class="sd-ai-review-actions">
            <button id="ai-generate-unavailable" class="sd-ai-disabled-generate" type="button"
                    disabled aria-describedby="ai-generate-reason">Generate unavailable</button>
            <button type="submit" class="sd-ai-review-button"
                    <%= "disabled" if @candidate_messages.empty? %>>
              <%= sd_icon("eye", size: 17) %> Review selected scope
            </button>
          </div>
        </div>
      <% end %>
    </section>

    <aside class="sd-ai-privacy" aria-labelledby="ai-privacy-heading">
      <div class="sd-ai-section-heading">
        <%= sd_icon("shield", size: 19) %>
        <div>
          <h2 id="ai-privacy-heading">Privacy &amp; cost gate</h2>
          <p><%= @semantic_tasks_enabled ? "One paid request needs explicit author approval and all room-member grants." : "External model processing is unavailable." %></p>
        </div>
      </div>
      <div class="sd-ai-policy-row">
        <strong>Permission</strong>
        <span>Room member grants must be rechecked for each request; selecting a task does not grant consent.</span>
      </div>
      <div class="sd-ai-policy-row">
        <strong>Context</strong>
        <span>Never send unselected messages, member lists, files or whole history by default.</span>
      </div>
      <div class="sd-ai-policy-row">
        <strong>Provider &amp; budget</strong>
        <span><%= @semantic_tasks_enabled ? "Local development budget: $0.10 reserved per request, $0.30 daily per user, $1.00 monthly per user, $2.00 monthly globally. Provider charges may exceed a reservation." : "No provider configured here; no external calls from this page." %></span>
      </div>
      <div class="sd-ai-future-state">
        <%= sd_icon("lock", size: 16) %>
        <p id="ai-generate-reason"><%= @semantic_tasks_enabled ? "This Workspace does not issue paid calls. Open the conversation editor and explicitly authorize each selected task; review and Send remain separate." : "Generation stays unavailable until the provider, retention terms, consent and spending caps are approved. Local Client Brief remains free." %></p>
      </div>
    </aside>
  </div>

  <% if @review %>
    <section id="ai-scope-review" class="sd-ai-preview" aria-labelledby="ai-preview-heading" role="region">
      <div class="sd-ai-section-heading">
        <%= sd_icon("eye", size: 19) %>
        <div>
          <h2 id="ai-preview-heading">Selected context — local preview only</h2>
          <p><%= AiWorkspace::Scope::OPERATIONS.fetch(@review.operation) %> ·
            <%= @review.rows.size %> messages ·
            <%= @review.characters %> text characters</p>
        </div>
      </div>
      <ol class="sd-ai-preview-list">
        <% @review.rows.each do |message| %>
          <li data-ai-preview-message-id="<%= message.message_id %>">
            <strong><%= message.author %></strong>
            <p><%= message.text %></p>
            <% if message.truncated %>
              <span class="sd-ai-truncated">Preview limited to <%= AiWorkspace::Scope::MAX_MESSAGE_CHARS %> characters for this message.</span>
            <% end %>
          </li>
        <% end %>
      </ol>
      <% if @preset && @preparation %>
        <div id="ai-preset-review" class="sd-ai-preset-review" aria-label="Offline preset configuration">
          <strong><%= @preset.label %> · v<%= @preset.version %></strong>
          <p><%= @preset.snapshot.fetch("tone").capitalize %> tone ·
             <%= @preset.snapshot.fetch("style") %> style ·
             <%= @preset.snapshot.fetch("audience") %> audience ·
             locale <%= @preset.locale.upcase %></p>
          <p>Manual context, maximum <%= @preset.snapshot.dig("context", "max_messages") %> messages.
             Preserve facts; do not invent prices or deadlines. Explicit author approval required.
             Plain-text output, one future variant.</p>
          <p>Offline preparation: <%= @preparation.characters %> normalized characters.
             No model result, saved request, auto-send or external processing.</p>
          <% if @preset_warning_labels.any? %>
            <p class="sd-ai-preset-warnings">Review flags: <%= @preset_warning_labels.join(", ") %>.
              No sensitive values are displayed by the flags.</p>
          <% end %>
        </div>
      <% end %>
      <p class="sd-ai-preview-note"><%= sd_icon("shield", size: 16) %>
        Preview complete. No AI response was generated or requested.
      </p>
    </section>
  <% end %>
</section>
