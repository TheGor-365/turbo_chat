<nav class="sd-nav" aria-label="Main navigation"
     data-controller="<%= "profile-labels" if user_signed_in? %>">
  <div class="sd-nav__inner">
    <%= link_to root_path, class: "sd-brand", title: "Turbo Chat home" do %>
      <span class="sd-brand__mark"><%= sd_icon("messages", size: 19) %></span>
      <span class="sd-brand__wordmark">Turbo Chat</span>
    <% end %>

    <div class="sd-nav__actions">
      <% if user_signed_in? %>
        <%= link_to rooms_path, class: "sd-icon-button", title: "Conversations",
          aria: { label: "Conversations" } do %>
          <%= sd_icon("messages") %>
          <span class="sd-visually-hidden">Conversations</span>
        <% end %>

        <%= link_to edit_user_registration_path, class: "sd-nav__account",
          title: "Profile & settings", aria: { label: "Profile & settings" } do %>
          <% if current_user.avatar.attached? %>
            <%= image_tag user_avatar_path(current_user),
              class: "sd-nav__avatar", width: 30, height: 30, alt: "" %>
          <% else %>
            <span class="sd-nav__avatar sd-nav__avatar--initial" role="img" aria-label="Account avatar"
                  data-profile-initial-user-id="<%= current_user.id %>"><%= current_user.chat_label.first.upcase %></span>
          <% end %>
          <span class="sd-nav__identity" data-profile-label-user-id="<%= current_user.id %>"><%= current_user.chat_label %></span>
        <% end %>
      <% end %>

      <button type="button" class="sd-icon-button"
              data-action="theme#cycle" data-theme-target="toggle"
              aria-label="Theme: Dark. Switch to Light"
              title="Theme: Dark · switch to Light">
        <span class="sd-theme-icon sd-theme-icon--dark"><%= sd_icon("moon") %></span>
        <span class="sd-theme-icon sd-theme-icon--light"><%= sd_icon("sun") %></span>
        <span class="sd-theme-icon sd-theme-icon--system"><%= sd_icon("monitor") %></span>
        <span class="sd-visually-hidden">Change color theme</span>
      </button>

      <% if user_signed_in? %>
        <%= button_to destroy_user_session_path, method: :delete,
          form: { class: "sd-nav__logout" }, class: "sd-icon-button",
          title: "Log out", aria: { label: "Log out" } do %>
          <%= sd_icon("log-out") %>
          <span class="sd-visually-hidden">Log out</span>
        <% end %>
      <% else %>
        <%= link_to "Log in", new_user_session_path, class: "sd-nav__auth-link" %>
        <%= link_to "Sign up", new_user_registration_path,
          class: "sd-nav__auth-link sd-nav__auth-link--primary" %>
      <% end %>
    </div>
  </div>
</nav>
