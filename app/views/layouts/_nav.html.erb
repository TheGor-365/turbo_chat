<nav class="navbar navbar-expand-lg navbar-dark bg-dark" aria-label="Main navigation">
  <div class="container">
    <%= link_to "Turbo Chat", root_path, class: "navbar-brand fw-semibold fs-4" %>
    <button
      class="navbar-toggler"
      type="button"
      data-bs-toggle="collapse"
      data-bs-target="#navbarSupportedContent"
      aria-controls="navbarSupportedContent"
      aria-expanded="false"
      aria-label="Toggle navigation"
    >
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarSupportedContent">
      <ul class="navbar-nav me-auto mb-2 mb-lg-0">
        <% if user_signed_in? %>
          <li class="nav-item">
            <%= link_to "Conversations", rooms_path, class: "nav-link" %>
          </li>
        <% end %>
      </ul>
      <div class="d-flex align-items-center flex-wrap gap-2">
        <% if user_signed_in? %>
          <%= link_to current_user.email, edit_user_registration_path, class: "text-decoration-none text-white-50" %>
          <% if current_user.avatar.attached? %>
            <%= image_tag user_avatar_path(current_user), class: "rounded-circle", width: 40, height: 40, style: "object-fit: cover;", alt: "Your avatar" %>
          <% end %>
          <%= button_to "Log out", destroy_user_session_path, method: :delete, class: "btn btn-outline-light" %>
        <% else %>
          <%= link_to "Log in", new_user_session_path, class: "btn btn-outline-light" %>
          <%= link_to "Sign up", new_user_registration_path, class: "btn btn-success" %>
        <% end %>
      </div>
    </div>
  </div>
</nav>
