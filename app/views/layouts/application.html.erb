<!DOCTYPE html>
<html lang="en" data-controller="theme" data-theme="dark">
  <head>
    <title>Turbo Chat</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <link rel="icon" href="/favicon.ico?v=h25" sizes="16x16 32x32" type="image/x-icon">
    <link rel="icon" href="/favicon.svg?v=h25" sizes="any" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=h25" sizes="180x180">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", defer: true %>

    <style media="screen">
      <%= ".msg-#{current_user&.id}" %> {
        background-color: var(--sd-bubble-outgoing) !important;
        color: var(--sd-bubble-outgoing-text) !important;
        padding: 10px !important;
      }
      <%= ".cont-#{current_user&.id}" %> {
        display: flex !important;
        justify-content: flex-end !important;
      }
    </style>
  </head>

  <body data-controller="error-dialog" data-action="turbo:before-fetch-response@document->error-dialog#intercept" class="sd-app bg-dark<%= " chat-workspace" if controller_path == "rooms" && %w[index show create].include?(action_name) %>">
    <a class="sd-skip-link" href="#main-content" data-controller="skip-link" data-action="click->skip-link#activate">Skip to content</a>
    <header>
      <%= render 'layouts/nav' %>
    </header>

    <main id="main-content" tabindex="-1">
      <%= yield %>
    </main>
    <dialog class="sd-ui-error-dialog" data-error-dialog-target="dialog"
      data-action="click->error-dialog#backdrop close->error-dialog#closed"
      aria-labelledby="sd-ui-error-dialog-title" aria-describedby="sd-ui-error-dialog-message">
      <div class="sd-ui-error-card sd-ui-error-card--dialog">
        <div class="sd-ui-error-card__symbol" aria-hidden="true"><%= sd_icon("shield", size: 25) %></div>
        <div class="sd-ui-error-card__eyebrow">TURBO CHAT · ACTION NOT COMPLETED</div>
        <h2 id="sd-ui-error-dialog-title" data-error-dialog-target="title">Action unavailable</h2>
        <p id="sd-ui-error-dialog-message" data-error-dialog-target="message">This action cannot be completed right now.</p>
        <div class="sd-ui-error-card__actions">
          <button type="button" class="sd-ui-error-card__primary"
            data-error-dialog-target="closeButton" data-action="error-dialog#close">
            Close and continue
          </button>
          <%= link_to "Conversations", rooms_path, class: "sd-ui-error-card__secondary" %>
        </div>
        <span class="sd-ui-error-card__code" data-error-dialog-target="status">Request not completed</span>
      </div>
    </dialog>
  </body>
</html>
