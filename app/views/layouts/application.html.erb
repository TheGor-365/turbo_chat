<!DOCTYPE html>
<html lang="en" data-controller="theme" data-theme="dark">
  <head>
    <title>Turbo Chat</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <link rel="icon" href="/favicon.ico?v=h25" sizes="16x16 32x32" type="image/x-icon">
    <link rel="icon" href="/favicon.svg?v=h25" sizes="any" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=h25" sizes="180x180">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", defer: true %>

    <style media="screen">
      <%= ".msg-#{current_user&.id}" %> {
        background-color: var(--sd-bubble-outgoing) !important;
        color: var(--sd-bubble-outgoing-text) !important;
        padding: 10px !important;
      }
      <%= ".cont-#{current_user&.id}" %> {
        display: flex !important;
        justify-content: flex-end !important;
      }
    </style>
  </head>

  <body class="sd-app bg-dark<%= " chat-workspace" if controller_path == "rooms" && %w[index show create].include?(action_name) %>">
    <a class="sd-skip-link" href="#main-content">Skip to content</a>
    <header>
      <%= render 'layouts/nav' %>
    </header>

    <main id="main-content" tabindex="-1">
      <%= yield %>
    </main>
  </body>
</html>
