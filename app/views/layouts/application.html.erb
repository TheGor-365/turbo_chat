<!DOCTYPE html>
<html lang="<%= I18n.locale %>" data-controller="theme" data-theme="dark">
  <head>
    <title>Turbo Chat</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%# Turbo 8 speculative GETs on mouse hover can emit fetch-response before a click.
        Never trigger user-facing 4xx modals for hover-only prefetches. %>
    <meta name="turbo-prefetch" content="false">
    <link rel="icon" href="/favicon.ico?v=h25" sizes="16x16 32x32" type="image/x-icon">
    <link rel="icon" href="/favicon.svg?v=h25" sizes="any" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=h25" sizes="180x180">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", defer: true %>

    <style media="screen">
      <%= ".msg-#{current_user&.id}" %> {
        background-color: var(--sd-bubble-outgoing) !important;
        color: var(--sd-bubble-outgoing-text) !important;
        padding: 10px !important;
      }
      <%= ".cont-#{current_user&.id}" %> {
        display: flex !important;
        justify-content: flex-end !important;
      }
    </style>
  </head>

  <body data-controller="error-dialog simple-chat review-sheet" data-ui-locale="<%= I18n.locale %>"
        data-ui-theme-labels="<%= theme_labels_for_ui.to_json %>"
        data-simple-chat-user-value="<%= current_user&.id || 0 %>" data-chat-ui-mode="simple" data-action="turbo:before-fetch-response@document->error-dialog#intercept" class="sd-app bg-dark<%= " chat-workspace" if controller_path == "rooms" && %w[index show create].include?(action_name) %>">
    <a class="sd-skip-link" href="#main-content" data-controller="skip-link" data-action="click->skip-link#activate"><%= t("ui.nav.skip") %></a>
    <header>
      <%= render 'layouts/nav' %>
    </header>

    <main id="main-content" tabindex="-1">
      <%= yield %>
    </main>
    <dialog class="sd-ui-error-dialog" data-error-dialog-target="dialog"
      data-action="click->error-dialog#backdrop close->error-dialog#closed"
      aria-labelledby="sd-ui-error-dialog-title" aria-describedby="sd-ui-error-dialog-message">
      <div class="sd-ui-error-card sd-ui-error-card--dialog">
        <div class="sd-ui-error-card__symbol" aria-hidden="true"><%= sd_icon("shield", size: 25) %></div>
        <div class="sd-ui-error-card__eyebrow">TURBO CHAT · ACTION NOT COMPLETED</div>
        <h2 id="sd-ui-error-dialog-title" data-error-dialog-target="title">Action unavailable</h2>
        <p id="sd-ui-error-dialog-message" data-error-dialog-target="message">This action cannot be completed right now.</p>
        <div class="sd-ui-error-card__actions">
          <button type="button" class="sd-ui-error-card__primary"
            data-error-dialog-target="closeButton" data-action="error-dialog#close">
            Close and continue
          </button>
          <%= link_to "Conversations", rooms_path, class: "sd-ui-error-card__secondary" %>
        </div>
        <span class="sd-ui-error-card__code" data-error-dialog-target="status">Request not completed</span>
      </div>
    </dialog>

    <%# JS-enhanced, same-origin TaskSheet. Existing links remain normal GET fallbacks.
        Never embed in an iframe: the app intentionally sets frame-ancestors 'none'.
        The controller reads rendered HTML and submits existing Rails forms without
        changing their endpoints or CSRF tokens. %>
    <dialog id="sd-review-sheet" class="sd-review-sheet"
            data-review-sheet-target="dialog"
            data-review-sheet-copy-value="<%= {
              loading: t("ui.document_review.modal_loading"),
              unavailable: t("ui.document_review.modal_unavailable"),
              forbidden: t("ui.document_review.modal_forbidden"),
              invalid: t("ui.document_review.modal_invalid"),
              saved: t("ui.document_review.modal_saved"),
              open_saved: t("ui.document_review.modal_open_saved")
            }.to_json %>"
            data-action="click->review-sheet#backdrop close->review-sheet#closed submit->review-sheet#submit click->review-sheet#follow"
            aria-labelledby="sd-review-sheet-title" aria-describedby="sd-review-sheet-caption">
      <div class="sd-review-sheet__header">
        <div class="sd-review-sheet__identity">
          <span class="sd-review-sheet__eyebrow"><%= sd_icon("shield-check", size: 14) %> <%= t("ui.document_review.eyebrow") %></span>
          <h2 id="sd-review-sheet-title"><%= t("ui.document_review.title") %></h2>
          <p id="sd-review-sheet-caption"><%= t("ui.document_review.modal_caption") %></p>
        </div>
        <button type="button" class="sd-review-sheet__close"
                data-review-sheet-target="closeButton"
                data-action="click->review-sheet#close"
                aria-label="<%= t("ui.document_review.modal_close") %>"
                title="<%= t("ui.document_review.modal_close") %>"><%= sd_icon("x", size: 19) %></button>
      </div>
      <div class="sd-review-sheet__feedback" data-review-sheet-target="status"
           role="status" aria-live="polite" hidden></div>
      <div class="sd-review-sheet__content" data-review-sheet-target="content"></div>
    </dialog>
  </body>
</html>
