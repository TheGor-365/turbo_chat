                <span class="sd-ai-ui-action-icon" aria-hidden="true"><%= sd_icon("file-text", size: 19) %></span>
                <span class="sd-ai-ui-action-label">
                  <strong><%= t("ui.room_instruction_context.title") %></strong>
                  <small><%= t("ui.room_instruction_context.description") %></small>
                </span>
                <input type="checkbox" class="sd-toggle" role="switch"
                       data-ai-draft-target="roomInstructionToggle"
                       data-action="change->ai-draft#changeRoomInstructionToggle"
                       autocomplete="off">
              </label>
              <details class="sd-ai-help-disclosure sd-ai-context-instruction-option__details">
                <summary><%= sd_icon("info", size: 15) %> <%= t("ui.chat_compose.details") %></summary>
                <p class="sd-ai-context-instruction-option__limit"><%= t("ui.room_instruction_context.limit") %></p>
              </details>
              <div class="sd-ai-context-instruction-preview" data-ai-draft-target="roomInstructionPreview"
