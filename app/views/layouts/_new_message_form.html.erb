             <h5><%= sd_icon("sparkles", size: 17) %><%= t("ui.chat_compose.policy_work_title") %></h5>
             <ul>
               <li><%= t("ui.chat_compose.policy_work_draft") %></li>
               <% if manual_ai_available %><li><%= t("ui.chat_compose.policy_work_styles") %></li><% end %>
               <% if contextual_ai_available %><li><%= t("ui.chat_compose.policy_work_context") %></li><% end %>
             </ul>
           </section>
           <section class="sd-ai-policy-card sd-ai-policy-card--data">
             <h5><%= sd_icon("file-text", size: 17) %><%= t("ui.chat_compose.policy_data_title") %></h5>
             <ul>
               <% if manual_ai_available %><li><%= t("ui.chat_compose.policy_data_draft") %></li><% end %>
               <% if contextual_ai_available %>
                 <li><%= t("ui.chat_compose.policy_data_context") %></li>
                 <li><%= t("ui.chat_compose.policy_data_excluded") %></li>
               <% else %>
                 <li><%= t("ui.chat_compose.context_disabled") %></li>
               <% end %>
             </ul>
           </section>
           <section class="sd-ai-policy-card sd-ai-policy-card--safety">
             <h5><%= sd_icon("shield-check", size: 17) %><%= t("ui.chat_compose.policy_safety_title") %></h5>
             <ul>
               <li><%= t("ui.chat_compose.policy_safety_send") %></li>
               <% if contextual_ai_available %>
                 <li><%= t("ui.chat_compose.policy_safety_consent") %></li>
                 <li><%= t("ui.chat_compose.policy_safety_evidence") %></li>
               <% end %>
               <% if manual_ai_available %><li><%= t("ui.chat_compose.policy_safety_logging") %></li><% end %>
             </ul>
             <% if contextual_ai_available %>
               <p data-ai-draft-target="contextSources" hidden></p>
               <details class="sd-ai-evidence-review" data-ai-draft-target="evidenceReview" hidden>
                 <summary data-ai-draft-target="evidenceReviewSummary"><%= t("ui.chat_compose.evidence_review") %></summary>
                 <p><%= t("ui.chat_compose.evidence_note") %></p>
                 <ol data-ai-draft-target="evidenceReviewIssues"></ol>
               </details>
             <% end %>
           </section>
           <section class="sd-ai-policy-card sd-ai-policy-card--cost">
             <h5><%= sd_icon("wallet", size: 17) %><%= t("ui.chat_compose.policy_cost_title") %></h5>
             <ul>
               <% if manual_ai_available %>
                 <li><%= t("ui.chat_compose.policy_cost_reservation") %></li>
                 <li><%= t("ui.chat_compose.policy_cost_limits") %></li>
                 <li><%= t("ui.chat_compose.policy_cost_variance") %></li>
               <% else %>
                 <li><%= t("ui.chat_compose.manual_unavailable") %></li>
               <% end %>
             </ul>
             <% if manual_ai_available %><p data-ai-draft-target="providerCost" hidden></p><% end %>
           </section>
         </div>
       </details>
      </section>
       <p id="ai-draft-caption" class="sd-ai-draft-disclaimer"><%= sd_icon("info", size: 14) %> <%= t("ui.chat_compose.send_manual") %></p>
    </dialog>
    <div class="composer-camera" data-message-composer-target="cameraPanel" hidden>
      <video data-message-composer-target="cameraVideo" autoplay muted playsinline aria-label="<%= t("ui.chat_compose.camera_preview") %>"></video>
