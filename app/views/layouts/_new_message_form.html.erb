                <div class="sd-ai-context-instruction-preview__inner">
                  <strong data-ai-draft-target="roomInstructionRevision"></strong>
                  <pre data-ai-draft-target="roomInstructionText"></pre>
                  <p><%= t("ui.room_instruction_context.scope") %></p>
