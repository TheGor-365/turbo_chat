                    <summary class="sd-ai-evidence__summary">
                      <%= sd_icon("search", size: 16) %>
                      <strong><%= t("ui.ai_evidence.heading") %></strong>
                    </summary>
                    <div class="sd-ai-evidence__body">
                      <p class="sd-ai-evidence__intro"><%= t("ui.ai_evidence.intro") %></p>
                      <div class="sd-ai-evidence__form" role="search">
                        <label for="ai-evidence-query"><%= t("ui.ai_evidence.query_label") %></label>
                        <input id="ai-evidence-query" type="search" maxlength="120" minlength="3"
                               autocomplete="off" data-ai-evidence-target="query" data-action="keydown.enter->ai-evidence#search"
                               placeholder="<%= t("ui.ai_evidence.placeholder") %>">
                        <button type="button" data-ai-evidence-target="submit" data-action="click->ai-evidence#search"><%= t("ui.ai_evidence.search") %></button>
                      </div>
                      <p class="sd-ai-evidence__status" role="status" aria-live="polite"
                         data-ai-evidence-target="status"></p>
                      <div class="sd-ai-evidence__results" data-ai-evidence-target="results" hidden>
                        <p class="sd-ai-evidence__summary-line" data-ai-evidence-target="summary"></p>
                        <section class="sd-ai-evidence__chronology" aria-label="<%= t("ui.ai_evidence.chronology_heading") %>">
                          <h5><%= sd_icon("clock", size: 15) %> <%= t("ui.ai_evidence.chronology_heading") %></h5>
                          <p><%= t("ui.ai_evidence.chronology_scope") %></p>
                          <ol data-ai-evidence-target="timeline" class="sd-ai-evidence__timeline"></ol>
                          <ul data-ai-evidence-target="relations" class="sd-ai-evidence__relations"></ul>
                        </section>
                        <p class="sd-ai-evidence__review-count" data-ai-evidence-target="reviewCount" role="status" aria-live="polite"></p>
                        <ol class="sd-ai-evidence__items" data-ai-evidence-target="items"></ol>
                        <ul class="sd-ai-evidence__conflicts" data-ai-evidence-target="conflicts"></ul>
                        <p class="sd-ai-evidence__caveat"><%= t("ui.ai_evidence.caveat") %></p>
                      </div>
                    </div>
                  </details>
                  <p class="sd-ai-coverage__notice"><%= sd_icon("shield-check", size: 15) %>
                    <%= t("ui.ai_coverage.info") %></p>
                </div>
              </details>
              <div class="sd-ai-source-review__workflow" role="status" aria-live="polite"
                   data-ai-draft-target="workflowNotice" hidden></div>
              <ul class="sd-ai-source-review__rules" data-ai-draft-target="sourceReviewRules" hidden>
                <li><%= sd_icon("shield-check", size: 14) %><%= t("ui.chat_runtime.ai.source_rule_fallback") %></li>
                <li><%= sd_icon("clock", size: 14) %><%= t("ui.chat_runtime.ai.source_rule_expiry") %></li>
                <li><%= sd_icon("search", size: 14) %><%= t("ui.chat_runtime.ai.source_rule_factcheck") %></li>
              </ul>
              <div class="sd-ai-business-plan" data-ai-draft-target="businessPlan" hidden>
