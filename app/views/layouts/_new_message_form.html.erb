<% writing_room_peer = @single_room.direct_message? ? @single_room.participants.find { |entry| entry.user_id != current_user.id }&.user : nil %>
<% room_writing_preference = AiRoomWritingPreference.find_by(room_id: @single_room.id, user_id: current_user.id) %>
<% account_writing_preference = AiAccountWritingPreference.find_by(user_id: current_user.id) %>
<% writing_room_label = writing_room_peer&.chat_label || (@single_room.direct_message? ? t("ui.conversation.direct_conversation") : @single_room.name) %>
<% room_context_people = @single_room.participants.includes(:user).first(4).map(&:user).compact %>
<% room_context_avatars = capture do %>
  <span class="sd-ai-inline-avatars" aria-hidden="true">
    <% room_context_people.each do |person| %>
      <% if person.avatar.attached? %>
        <%= image_tag user_avatar_path(person), alt: "", loading: "lazy" %>
      <% else %>
        <span class="sd-ai-inline-avatar-fallback"><%= person.chat_label.strip.slice(0, 1).upcase %></span>
      <% end %>
    <% end %>
  </span>
<% end %>
<% manual_ai_available = AiWorkspace::ManualDraftGeneration.enabled? %>
<% contextual_ai_available = AiWorkspace::ContextReplyGeneration.enabled? && @single_room.is_private? %>
<% context_tasks_available = AiWorkspace::ContextTaskGeneration.enabled? && contextual_ai_available %>
<% ai_style_icons = {
  "polish_clarity" => "sparkles", "professional_client_reply" => "mail",
  "friendly" => "smile", "concise" => "filter",
  "translate_preserving_tone" => "globe", "technical_summary" => "file-text"
}.freeze %>
<% ai_style_descriptions = {
  "polish_clarity" => "Clearer wording",
  "professional_client_reply" => "For clients",
  "friendly" => "Warm and natural",
  "concise" => "Short and direct",
  "translate_preserving_tone" => "Keep the tone",
  "technical_summary" => "Key technical points"
}.freeze %>
<div class="msg-form sd-composer-dock" data-controller="ai-draft quick-beautify<%= " ai-answer-entry ai-context-studio" if @single_room.is_private? %>"
     <% if @single_room.is_private? %>
     data-ai-context-studio-url-value="<%= room_ai_context_messages_path(@single_room) %>"
     data-ai-context-studio-room-id-value="<%= @single_room.id %>"
     data-ai-context-studio-user-id-value="<%= current_user.id %>"
     data-ai-context-studio-room-name-value="<%= writing_room_label %>"
     data-ai-context-studio-copy-value="<%= t("ui.ai_context_studio").to_json %>"
     <% end %>
     data-ai-answer-entry-goal-url-value="<%= room_ai_instruction_goal_path(@single_room) %>"
     data-ai-answer-entry-consent-url-value="<%= room_ai_context_consent_path(@single_room) %>"
     data-ai-answer-entry-preview-url-value="<%= room_ai_generation_input_preview_path(@single_room) %>"
     data-ai-answer-entry-instructions-url-value="<%= room_ai_instructions_path(@single_room) %>"
     data-ai-answer-entry-preference-options-value="<%= {
       profiles: AiWorkspace::ConversationExperienceV1::PROFILES.keys.map { |id|
         experience = AiWorkspace::ConversationExperienceV1.resolve(profile_id: id)
         { id: id, label: t("ui.chat_compose.quick_profile_#{id}"),
           style: experience.settings.fetch(:writing_style),
           tone: experience.settings.fetch(:tone) }
       },
       styles: AiWorkspace::PresetRegistry.bundled.all.map { |preset|
         { id: preset.id, label: t("ui.chat_compose.#{preset.id}") }
       },
       languages: AiWorkspace::ConversationExperienceV1::FIELD_VALUES.fetch(:language).map { |id|
         { id: id, label: t("ui.chat_compose.room_pref_lang_#{id}") }
       },
       tones: AiWorkspace::ConversationExperienceV1::FIELD_VALUES.fetch(:tone).map { |id|
         { id: id, label: t("ui.chat_compose.room_pref_tone_#{id}") }
       }
     }.to_json %>"
     data-ai-answer-entry-synthetic-value="<%= AiWorkspace::AnswerGeneration.synthetic_enabled? ? 'true' : 'false' %>"
     <% if AiWorkspace::AnswerGeneration.enabled? %>data-ai-answer-entry-generate-url-value="<%= generate_room_ai_answer_path(@single_room) %>"<% end %>
     data-ai-answer-entry-copy-value="<%= t("ui.ai_answer_entry").to_json %>"
     data-ai-answer-entry-plan-copy-value="<%= t("ui.ai_generation_preview").to_json %>"
     data-quick-beautify-copy-value="<%= t("ui.chat_compose.quick").to_json %>"
     <% if manual_ai_available %>data-quick-beautify-url="<%= generate_room_ai_draft_path(@single_room) %>"<% end %>
     data-ai-draft-copy-value="<%= t("ui.chat_runtime.ai").to_json %>"
     data-ai-draft-room-preference-copy-value="<%= {
       syncing: t("ui.chat_compose.room_pref_syncing"),
       synced: t("ui.chat_compose.room_pref_synced"),
       localOnly: t("ui.chat_compose.room_pref_local_only")
     }.to_json %>"
     data-ai-draft-user-id="<%= current_user.id %>" data-ai-draft-room-id="<%= @single_room.id %>"
     data-ai-draft-saved-preference="<%= room_writing_preference&.public_snapshot.to_json %>"
     data-ai-draft-account-preference="<%= account_writing_preference&.public_snapshot.to_json %>"
     data-ai-draft-preference-source="<%= room_writing_preference ? "room" : (account_writing_preference ? "account" : "system") %>"
     data-ai-draft-room-preference-url="<%= room_ai_writing_preference_path(@single_room) %>"
     data-ai-draft-room-path="<%= room_path(@single_room) %>"
     <% if manual_ai_available %>data-ai-draft-generate-url="<%= generate_room_ai_draft_path(@single_room) %>"<% end %>
     <% if @single_room.is_private? %>
       data-ai-draft-context-status-url="<%= room_ai_context_consent_path(@single_room) %>"
       data-ai-draft-context-consent-url="<%= room_ai_context_consent_path(@single_room) %>"
     <% end %>
     <% if contextual_ai_available %>
       data-ai-draft-context-reply-url="<%= generate_room_ai_context_reply_path(@single_room) %>"
       data-ai-draft-context-preview-url="<%= preview_room_ai_context_path(@single_room) %>"
       data-ai-draft-review-url="<%= room_ai_deliverable_review_path(@single_room) %>"
       <% if context_tasks_available %>
         data-ai-draft-context-task-url="<%= generate_room_ai_context_task_path(@single_room) %>"
       <% end %>
     <% end %>
     data-action="turbo:submit-end->ai-draft#submitEnd turbo:submit-end->quick-beautify#submitEnd ai-draft:preset-change->quick-beautify#presetChanged ai-draft:preferences-saved->ai-answer-entry#settingsChanged room-ai-instructions:saved->ai-answer-entry#settingsChanged room-ai-instructions:saved->ai-answer-entry#refresh">
  <div class="sd-ai-sheet-backdrop" data-ai-draft-target="backdrop" data-action="click->ai-draft#close" aria-hidden="true" hidden></div>
  <%= form_with model: [@single_room, @message], class: "message-composer sd-message-composer",
      data: {
        controller: "message-composer",
        action: "submit->message-composer#beforeSubmit submit->quick-beautify#beforeSubmit submit->ai-answer-entry#beforeSubmit submit->typing-indicator#stopTyping turbo:submit-start->message-composer#submitStart turbo:submit-start->quick-beautify#submitStart turbo:submit-end->message-composer#submitEnd turbo:submit-end->ai-answer-entry#submitEnd"
      } do |f| %>
    <div class="composer-drop-hint" aria-hidden="true"><%= t("ui.chat_compose.drop") %></div>
    <div class="composer-reply" data-message-composer-target="replyPreview" hidden aria-label="<%= t("ui.chat_compose.replying") %>">
      <span data-message-composer-target="replyPreviewText"></span>
      <button type="button" class="sd-icon-button sd-quiet-action"
        data-action="click->message-composer#clearReply" aria-label="<%= t("ui.chat_compose.cancel_reply") %>" title="<%= t("ui.chat_compose.cancel_reply") %>">
        <%= sd_icon("x", size: 18) %>
      </button>
    </div>
    <%= f.hidden_field :reply_to_id, value: nil, data: { message_composer_target: "replyTo" } %>
    <div class="composer-previews" data-message-composer-target="previews" role="list" aria-label="<%= t("ui.chat_compose.attachments") %>" hidden></div>
    <div class="sd-composer-inspectors sd-composer-inspectors--unified" role="group" aria-label="<%= t("ui.chat_compose.tools_status") %>">
      <% if @single_room.is_private? %>
        <button type="button" class="sd-ai-context-launch sd-composer-tool-trigger"
                data-action="click->ai-context-studio#open"
                aria-haspopup="dialog" aria-controls="sd-ai-context-studio">
          <%= sd_icon("messages", size: 15) %>
          <%= t("ui.ai_context_studio.button") %>
        </button>
      <% end %>
      <% if @single_room.is_private? %>
        <button type="button" class="sd-ai-plan-inspect-button sd-composer-tool-trigger"
                data-ai-answer-entry-target="planButton"
                data-action="click->ai-answer-entry#inspectPlan"
                aria-controls="sd-ai-effective-plan" aria-expanded="false"
                aria-label="<%= t("ui.ai_generation_preview.inspectPlan") %>"
                title="<%= t("ui.ai_generation_preview.disclaimer") %>">
          <%= sd_icon("file-text", size: 14) %>
          <%= t("ui.ai_generation_preview.inspectPlan") %>
        </button>
      <% end %>
      <details class="sd-composer-inspector sd-composer-inspector--message">
        <summary title="<%= t("ui.chat_compose.message_settings_title") %>" data-action="click->ai-draft#openComposerEditor">
          <%= sd_icon("pencil", size: 15) %>
          <span><%= t("ui.chat_compose.message_settings_title") %></span>
          
        </summary>
        <div class="sd-composer-inspector__content sd-visually-hidden">
          <button type="button" class="sd-composer-inspector__navigate"
                  data-action="click->ai-draft#showEditor">
            <%= sd_icon("settings", size: 15) %>
            <%= t("ui.chat_compose.message_settings_title") %>
          </button>
          <span class="sd-ai-room-state" data-ai-draft-target="aiIndicator"
                title="<%= t(manual_ai_available ? "ui.chat_compose.manual_ai_hint" : "ui.chat_compose.ai_unavailable") %>">
            <%= sd_icon("sparkles", size: 15) %>
            <%= t(manual_ai_available ? "ui.chat_runtime.ai.status_manual" : "ui.chat_runtime.ai.status_ai_off") %>
          </span>
          <span class="sd-ai-room-state sd-ai-room-spell" data-ai-draft-target="spellIndicator"
                data-enabled="true" title="<%= t("ui.chat_compose.browser_spelling") %>">
            <%= sd_icon("check", size: 15) %>
            <span data-ai-draft-target="spellIndicatorLabel"><%= t("ui.chat_runtime.ai.spell_on") %></span>
          </span>
        </div>
      </details>
      <details class="sd-composer-inspector sd-composer-inspector--room">
        <summary title="<%= t("ui.chat_compose.room_settings") %>" data-action="click->ai-draft#openComposerRoom">
          <%= sd_icon("sliders-horizontal", size: 15) %>
          <span><%= t("ui.chat_compose.room_settings") %></span>
          <span class="sd-composer-inspector__led" aria-hidden="true"><%= sd_icon("shield-check", size: 12) %></span>
          
        </summary>
        <div class="sd-composer-inspector__content sd-visually-hidden">
          <button type="button" class="sd-composer-inspector__navigate"
                  data-action="click->ai-draft#showSettings">
            <%= sd_icon("settings", size: 15) %>
            <%= t("ui.chat_compose.room_settings") %>
          </button>
          <span class="sd-ai-room-state" data-ai-draft-target="autoIndicator"
                title="<%= t("ui.chat_compose.auto_unavailable") %>">
            <%= sd_icon("zap", size: 15) %>
            <%= t("ui.chat_runtime.ai.status_auto_off") %>
          </span>
          <% if @single_room.is_private? %>
            <span class="sd-ai-consent-summary" data-ai-draft-target="consentSummary"
                  aria-live="polite" title="<%= t("ui.chat_compose.ai_permissions_hint") %>">
              <%= sd_icon("shield-check", size: 15) %>
              <span data-ai-draft-target="consentCount"><%= t("ui.chat_runtime.ai.count_checking") %></span>
            </span>
            <span class="sd-ai-consent-compact" data-ai-draft-target="consentCompact"
                  role="list" aria-label="<%= t("ui.chat_compose.each_permission") %>"></span>
          <% end %>
          <span class="sd-ai-room-preset" data-ai-draft-target="presetBadge"
                title="<%= t("ui.chat_compose.saved_style") %>"><%= t("ui.chat_compose.polish_clarity") %></span>
        </div>
      </details>
      <button type="button" class="sd-ai-quick-undo" data-ai-draft-target="quickUndo"
              data-action="click->ai-draft#undo" hidden
              aria-label="<%= t("ui.chat_compose.undo_ai") %>"
              title="<%= t("ui.chat_compose.undo_ai") %>">
        <%= sd_icon("refresh-cw", size: 14) %> <%= t("ui.chat_compose.undo_ai_text") %>
      </button>
    </div>
    <section class="sd-quick-beautify-panel" data-quick-beautify-target="panel"
             aria-label="<%= t("ui.chat_compose.quick.title") %>" hidden>
      <div class="sd-quick-beautify-head">
        <span class="sd-quick-beautify-brand" title="<%= t("ui.chat_compose.quick.aiIdentity") %>">
          <%= sd_icon("sparkles", size: 15) %> Beautify
        </span>
        <span class="sd-quick-beautify-cost" data-quick-beautify-target="cost" hidden></span>
        <button type="button" class="sd-quick-beautify-close" data-action="click->quick-beautify#close"
                aria-label="<%= t("ui.chat_compose.quick.keep") %>"><%= sd_icon("x", size: 16) %></button>
      </div>
      <div class="sd-quick-beautify-ai-row" data-quick-beautify-target="aiRow">
        <div class="sd-quick-beautify-identity" role="group" aria-label="<%= t("ui.chat_compose.quick.aiActions") %>">
          <button type="button" class="sd-quick-beautify-tool" data-quick-beautify-target="regenerate"
                  data-action="click->quick-beautify#regenerate"
                  aria-label="<%= t("ui.chat_compose.quick.regenerate") %>"
                  title="<%= t("ui.chat_compose.quick.regenerateHint") %>" disabled>
            <%= sd_icon("refresh-cw", size: 17) %>
          </button>
          <button type="button" class="sd-quick-beautify-tool" data-quick-beautify-target="settingsToggle"
                  data-action="click->quick-beautify#toggleSettings"
                  aria-label="<%= t("ui.chat_compose.quick.settings") %>"
                  title="<%= t("ui.chat_compose.quick.settings") %>"
                  aria-controls="quick-generation-settings" aria-expanded="false">
            <%= sd_icon("sliders-horizontal", size: 17) %>
          </button>
        </div>
        <div class="sd-quick-beautify-editor-field">
          <label for="quick-ai-text" class="sd-visually-hidden"><%= t("ui.chat_compose.quick.candidate") %></label>
          <textarea id="quick-ai-text" rows="1" maxlength="5000" data-quick-beautify-target="candidate"
                    data-action="input->quick-beautify#candidateChanged"
                    aria-label="<%= t("ui.chat_compose.quick.candidate") %>"
                    spellcheck="true" hidden></textarea>
          <button type="button" class="sd-quick-beautify-grip" data-resize-editor="ai"
                  data-action="pointerdown->quick-beautify#beginResize pointermove->quick-beautify#dragResize pointerup->quick-beautify#endResize pointercancel->quick-beautify#endResize keydown->quick-beautify#resizeWithKeyboard"
                  aria-label="<%= t("ui.chat_compose.quick.resizeAi") %>" title="<%= t("ui.chat_compose.quick.resizeAi") %>">
            <span aria-hidden="true"></span>
          </button>
        </div>
        <button type="submit" class="sd-quick-beautify-send" data-quick-beautify-target="sendAi"
                aria-label="<%= t("ui.chat_compose.quick.sendAi") %>"
                title="<%= t("ui.chat_compose.quick.sendAi") %>" disabled>
          <%= sd_icon("send", size: 20) %><%= sd_icon("sparkles", size: 11) %>
        </button>
      </div>
      <div id="quick-generation-settings" class="sd-quick-beautify-settings"
           data-quick-beautify-target="settingsPanel" role="group"
           aria-label="<%= t("ui.chat_compose.quick.settings") %>" hidden>
        <div class="sd-quick-beautify-options">
          <label for="quick-style"><span class="sd-ai-select-caption"><%= sd_icon("palette", size: 16) %><%= t("ui.chat_compose.writing_style") %></span>
            <select data-controller="ui-select" id="quick-style" data-quick-beautify-target="presetSelect"
                    data-action="change->quick-beautify#settingsChanged">
              <% AiWorkspace::PresetRegistry.bundled.all.reject { |preset| preset.operation == "translate" }.each do |preset| %>
                <option value="<%= preset.id %>"><%= t("ui.chat_compose.#{preset.id}") %></option>
              <% end %>
            </select>
          </label>
          <label for="quick-language"><span class="sd-ai-select-caption"><%= sd_icon("globe", size: 16) %><%= t("ui.chat_compose.room_pref_language") %></span>
            <select data-controller="ui-select" id="quick-language" data-quick-beautify-target="languageSelect"
                    data-action="change->quick-beautify#settingsChanged">
              <% AiWorkspace::ConversationExperienceV1::FIELD_VALUES.fetch(:language).each do |code| %>
                <option value="<%= code %>"><%= t("ui.chat_compose.room_pref_lang_#{code}") %></option>
              <% end %>
            </select>
          </label>
          <label for="quick-tone"><span class="sd-ai-select-caption"><%= sd_icon("sliders-horizontal", size: 16) %><%= t("ui.chat_compose.room_pref_tone") %></span>
            <select data-controller="ui-select" id="quick-tone" data-quick-beautify-target="toneSelect"
                    data-action="change->quick-beautify#settingsChanged">
              <% AiWorkspace::ConversationExperienceV1::FIELD_VALUES.fetch(:tone).each do |code| %>
                <option value="<%= code %>"><%= t("ui.chat_compose.room_pref_tone_#{code}") %></option>
              <% end %>
            </select>
          </label>
        </div>
        <p class="sd-quick-beautify-settings-hint"><%= t("ui.chat_compose.quick.settingsHint") %></p>
        <p class="sd-quick-beautify-settings-feedback" data-quick-beautify-target="settingsStatus"
           role="status" aria-live="polite"></p>
      </div>
      <p class="sd-quick-beautify-status" role="status" aria-live="polite"
         data-quick-beautify-target="status" hidden></p>
    </section>
    <% if @single_room.is_private? %>
      <section id="sd-ai-effective-plan" class="sd-ai-effective-plan"
               data-ai-answer-entry-target="planPanel" hidden role="region"
               aria-label="<%= t("ui.ai_generation_preview.title") %>">
        <button type="button" class="sd-ai-effective-plan__grip"
                data-ai-answer-entry-target="planGrip"
                data-action="pointerdown->ai-answer-entry#beginPlanResize pointermove->ai-answer-entry#dragPlanResize pointerup->ai-answer-entry#endPlanResize pointercancel->ai-answer-entry#endPlanResize keydown->ai-answer-entry#resizePlanWithKeyboard"
                aria-label="<%= t("ui.ai_generation_preview.resizePlan") %>"
                title="<%= t("ui.ai_generation_preview.resizePlan") %>">
          <span aria-hidden="true"></span>
        </button>
        <div class="sd-ai-effective-plan__head">
          <strong><%= sd_icon("file-text", size: 16) %> <%= t("ui.ai_generation_preview.title") %></strong>
          <button type="button" class="sd-ai-effective-plan__close"
                  data-action="click->ai-answer-entry#hidePlan"
                  aria-label="<%= t("ui.ai_generation_preview.closePlan") %>">
            <%= sd_icon("x", size: 17) %>
          </button>
        </div>
        <div class="sd-ai-effective-plan__intro">
          
          <p class="sd-ai-effective-plan__status" role="status" aria-live="polite"
             data-ai-answer-entry-target="planStatus"></p>
        </div>
        <div class="sd-ai-effective-plan__body" data-ai-answer-entry-target="planBody"></div>
        <template data-ai-plan-icons>
          <% %w[file-text sliders-horizontal messages reply filter inbox wallet shield-check globe
                 palette pencil info users check search].each do |icon_name| %>
            <span data-plan-icon="<%= icon_name %>"><%= sd_icon(icon_name, size: 17) %></span>
          <% end %>
        </template>
      </section>
      <%# Explicit readiness blockers live in the composer. Do not open the
          full AI Workspace when the author simply presses Answer. %>
      <section class="sd-ai-answer-readiness" data-ai-answer-entry-target="readiness"
               aria-live="polite" aria-label="<%= t("ui.ai_answer_entry.readinessTitle") %>"
               hidden>
        <span class="sd-ai-answer-readiness-icon" aria-hidden="true"><%= sd_icon("info", size: 17) %></span>
        <span class="sd-ai-answer-readiness-reason" data-ai-answer-entry-target="readinessText"></span>
        <div class="sd-ai-answer-readiness-actions">
          <button type="button" class="sd-ai-answer-readiness-action"
                  data-ai-answer-entry-target="readinessAction"
                  data-action="click->ai-answer-entry#resolveReadiness" hidden></button>
          <button type="button" class="sd-ai-answer-readiness-action"
                  data-ai-answer-entry-target="previewAction"
                  data-action="click->ai-answer-entry#preview" hidden><%= t("ui.ai_answer_entry.previewContextAction") %></button>
          <button type="button" class="sd-ai-answer-readiness-close"
                  data-action="click->ai-answer-entry#hideReadiness"
                  aria-label="<%= t("ui.ai_answer_entry.hideReadiness") %>"
                  title="<%= t("ui.ai_answer_entry.hideReadiness") %>"><%= sd_icon("x", size: 15) %></button>
        </div>
      </section>
      <section class="sd-ai-answer-result" data-ai-answer-entry-target="result" hidden
               aria-label="<%= t("ui.ai_answer_entry.previewTitle") %>">
        <%# Only the provider-free context preview uses verbose diagnostics.
            A generated AI candidate uses the SAME geometry as human Send. %>
        <div class="sd-ai-answer-candidate-head" data-ai-answer-entry-target="candidateHead" hidden>
          <span class="sd-ai-answer-candidate-brand"><%= sd_icon("sparkles", size: 15) %> AI Answer</span>
          <span class="sd-quick-beautify-cost sd-ai-answer-cost" data-ai-answer-entry-target="cost" hidden></span>
        </div>
        <div class="sd-ai-answer-result-head">
          <strong data-ai-answer-entry-target="resultHeading"><%= sd_icon("shield-check", size: 15) %> <%= t("ui.ai_answer_entry.privacy") %></strong>
        </div>
        <pre data-ai-answer-entry-target="resultText"></pre>
        <div class="sd-ai-answer-composer" data-ai-answer-entry-target="composer" hidden>
          <div class="sd-ai-answer-tools" role="toolbar"
               aria-label="<%= t("ui.ai_answer_entry.toolActions") %>">
            <span class="sd-ai-answer-composer-mark" title="AI Answer" aria-hidden="true"><%= sd_icon("sparkles", size: 16) %></span>
            <button type="button" class="sd-icon-button sd-quiet-action sd-ai-answer-regenerate"
                    data-ai-answer-entry-target="regenerate"
                    data-action="click->ai-answer-entry#regenerate"
                    aria-label="<%= t("ui.ai_answer_entry.regenerate") %>"
                    title="<%= t("ui.ai_answer_entry.regenerateOnlyAfterSettings") %>"
                    disabled><%= sd_icon("refresh-cw", size: 17) %></button>
            <button type="button" class="sd-icon-button sd-quiet-action sd-ai-answer-settings"
                    data-ai-answer-entry-target="settings"
                    data-action="click->ai-answer-entry#editSettings"
                    aria-label="<%= t("ui.ai_answer_entry.editSettings") %>"
                    title="<%= t("ui.ai_answer_entry.editSettings") %>"><%= sd_icon("sliders-horizontal", size: 17) %></button>
            <button type="button" class="sd-icon-button sd-quiet-action sd-ai-answer-discard"
                    data-action="click->ai-answer-entry#discard"
                    aria-label="<%= t("ui.ai_answer_entry.discard") %>"
                    title="<%= t("ui.ai_answer_entry.discard") %>"><%= sd_icon("x", size: 17) %></button>
          </div>
          <div class="sd-ai-answer-editor-field sd-composer-editor-field">
            <label class="sd-visually-hidden" for="ai-answer-candidate"
                   data-ai-answer-entry-target="candidateLabel" hidden><%= t(AiWorkspace::AnswerGeneration.synthetic_enabled? ? "ui.ai_answer_entry.syntheticCandidateLabel" : "ui.ai_answer_entry.candidateLabel") %></label>
            <textarea id="ai-answer-candidate"
                      class="sd-ai-answer-candidate sd-composer-input msg-content sd-composer-multiline"
                      rows="1" maxlength="5000" data-ai-answer-entry-target="candidate"
                      data-action="input->ai-answer-entry#candidateChanged keydown->ai-answer-entry#submitOnEnter"
                      aria-label="<%= t(AiWorkspace::AnswerGeneration.synthetic_enabled? ? "ui.ai_answer_entry.syntheticCandidateLabel" : "ui.ai_answer_entry.candidateLabel") %>"
                      spellcheck="true" hidden></textarea>
            <button type="button" class="sd-quick-beautify-grip sd-ai-answer-grip"
                    data-ai-answer-entry-target="grip"
                    data-action="pointerdown->ai-answer-entry#beginResize pointermove->ai-answer-entry#dragResize pointerup->ai-answer-entry#endResize pointercancel->ai-answer-entry#endResize keydown->ai-answer-entry#resizeWithKeyboard"
                    aria-label="<%= t("ui.ai_answer_entry.resizeAi") %>"
                    title="<%= t("ui.ai_answer_entry.resizeAi") %>">
              <span aria-hidden="true"></span>
            </button>
          </div>
          <button type="submit" class="sd-ai-answer-send sd-icon-button sd-icon-button--accent"
                  data-ai-answer-entry-target="sendAi"
                  aria-label="<%= t(AiWorkspace::AnswerGeneration.synthetic_enabled? ? "ui.ai_answer_entry.syntheticSendAfterReview" : "ui.ai_answer_entry.sendAfterReview") %>"
                  title="<%= t(AiWorkspace::AnswerGeneration.synthetic_enabled? ? "ui.ai_answer_entry.syntheticSendAfterReview" : "ui.ai_answer_entry.sendAfterReview") %>"
                  hidden>
            <%= sd_icon("send", size: 20) %>
            <%= sd_icon("sparkles", size: 11) %>
          </button>
        </div>
      </section>
    <% end %>
    <div class="composer-controls">
      <div class="sd-adaptive-ai-action">
      <% if @single_room.is_private? %>
        <button type="button" class="sd-ai-answer-entry"
                data-ai-answer-entry-target="trigger"
                data-action="click->ai-answer-entry#open"
                title="<%= t("ui.ai_answer_entry.buttonHint") %>"
                aria-label="<%= t("ui.ai_answer_entry.button") %>">
          <%= sd_icon("messages", size: 16) %>
          <span><%= t("ui.ai_answer_entry.button") %></span>
          <span class="sd-ai-answer-readiness-indicator" data-ai-answer-entry-target="indicator"
                aria-hidden="true"><%= sd_icon("shield-check", size: 12) %></span>
        </button>
        <span class="sd-ai-answer-status sd-visually-hidden"
              data-ai-answer-entry-target="status" role="status" aria-live="polite"><%= t("ui.ai_answer_entry.checking") %></span>
      <% end %>
      <button type="button" class="sd-quick-beautify-trigger" data-quick-beautify-target="generate"
              data-action="click->quick-beautify#generate"
              title="<%= t("ui.chat_compose.quick.hint") %>"
              aria-label="<%= t("ui.chat_compose.quick.hint") %>">
        <%= sd_icon("sparkles", size: 16) %> <span><%= t("ui.chat_compose.quick.action") %></span>
      </button>
      </div>
      <button type="button" id="ai-draft-toggle"
              class="sd-icon-button sd-quiet-action sd-ai-draft-toggle"
              title="<%= t("ui.chat_compose.edit_unsent") %>" aria-label="<%= t("ui.chat_compose.edit_unsent") %>"
              aria-controls="ai-draft-panel ai-room-settings" aria-expanded="false"
              data-ai-draft-target="toggle" data-action="click->ai-draft#toggle">
        <%= sd_icon("sparkles", size: 18) %>
      </button>
      <button type="button" class="sd-icon-button sd-quiet-action" title="<%= t("ui.chat_compose.take_photo") %>" aria-label="<%= t("ui.chat_compose.take_photo") %>"
        data-action="click->message-composer#openCamera">
        <%= sd_icon("camera", size: 19) %>
      </button>
      <label for="message_attachments" class="composer-attach sd-icon-button sd-quiet-action"
             title="<%= t("ui.chat_compose.attach") %>" aria-label="<%= t("ui.chat_compose.choose_files") %>" tabindex="0"
             role="button" data-action="keydown.enter->message-composer#openFiles keydown.space->message-composer#openFiles">
        <%= sd_icon("paperclip", size: 19) %>
      </label>
      <%= f.file_field :attachments, id: "message_attachments", multiple: true,
          accept: "image/jpeg,image/png,image/webp,application/pdf,text/plain,text/markdown,audio/webm,video/webm,.webm,.md,.markdown,.txt",
          class: "composer-file-input visually-hidden",
          data: { message_composer_target: "files", action: "change->message-composer#filesSelected" } %>
      <button type="button" class="sd-icon-button sd-quiet-action" title="<%= t("ui.chat_compose.record_voice") %>"
              aria-label="<%= t("ui.chat_compose.record_voice") %>" data-message-composer-target="voiceButton"
              data-action="click->message-composer#startVoice">
        <%= sd_icon("mic", size: 19) %>
      </button>

      <span class="sd-composer-human-icon" title="<%= t("ui.chat_compose.quick.humanIdentity") %>" aria-hidden="true">
        <%= sd_icon("pencil", size: 14) %>
      </span>
      <div class="sd-composer-editor-field">
<%= f.text_area :body, id: "chat-text", class: "sd-composer-input msg-content sd-composer-multiline",
          rows: 1, placeholder: t("ui.chat_compose.write_message"), autocomplete: "off",
          data: { message_composer_target: "body", ai_draft_target: "body", quick_beautify_target: "body", ai_answer_entry_target: "body", typing_indicator_target: "body",
                  action: "input->message-composer#resizeBody input->typing-indicator#changed input->ai-draft#draftChanged input->quick-beautify#changed input->ai-answer-entry#changed keydown->message-composer#submitOnEnter" },
          aria: { label: t("ui.chat_compose.message") } %>
        <button type="button" class="sd-quick-beautify-grip" data-resize-editor="manual"
                data-action="pointerdown->quick-beautify#beginResize pointermove->quick-beautify#dragResize pointerup->quick-beautify#endResize pointercancel->quick-beautify#endResize keydown->quick-beautify#resizeWithKeyboard"
                aria-label="<%= t("ui.chat_compose.quick.resizeMine") %>" title="<%= t("ui.chat_compose.quick.resizeMine") %>">
          <span aria-hidden="true"></span>
        </button>
      </div>
      <button type="submit" class="composer-send sd-icon-button sd-icon-button--accent"
              aria-label="<%= t("ui.chat_compose.send") %>" title="<%= t("ui.chat_compose.send") %>" data-message-composer-target="submit">
        <%= sd_icon("send", size: 20) %>
        <span class="sd-visually-hidden"><%= t("ui.chat_compose.send") %></span>
      </button>
    </div>
    <dialog id="ai-room-settings" class="sd-ai-room-settings"
             data-ai-draft-target="settingsPanel" aria-labelledby="ai-room-settings-title"
             role="dialog" aria-modal="true" data-action="cancel->ai-draft#closeSettings click->ai-draft#dismissOnBackdrop" hidden>
      <div class="sd-ai-workspace-topbar">
        <div class="sd-ai-mode-nav" role="group" aria-label="<%= t("ui.chat_compose.tools_view") %>">
          <button type="button" aria-pressed="false" data-action="click->ai-draft#showEditor">
            <%= sd_icon("pencil", size: 15) %> <%= t("ui.chat_compose.edit_draft") %>
          </button>
          <button type="button" aria-pressed="true" class="is-active" data-action="click->ai-draft#showSettings">
            <%= sd_icon("settings", size: 15) %> <%= t("ui.chat_compose.room_settings") %>
          </button>
        </div>
        <button type="button" class="sd-icon-button sd-quiet-action sd-ai-sheet-close"
                aria-label="<%= t("ui.chat_compose.close_settings") %>" title="<%= t("ui.chat_compose.close_settings") %>"
                data-action="click->ai-draft#closeSettings"><%= sd_icon("x", size: 18) %></button>
      </div>
      <h3 id="ai-room-settings-title" class="sd-room-settings-page-title"><%= t("ui.chat_compose.room_settings") %></h3>
      <div class="sd-ai-room-context" aria-label="<%= t("ui.chat_compose.preference_scope") %>">
        <span title="<%= t("ui.chat_compose.current_conversation") %>"><%= sd_icon("messages", size: 15) %> <%= room_context_avatars %>
          <span class="sd-ai-room-context-label"><%= t("ui.chat_compose.room") %></span>
          <strong <%= "data-profile-label-user-id=#{writing_room_peer.id}" if writing_room_peer %>><%= writing_room_label %></strong>
        </span>
        <span title="<%= t("ui.chat_compose.preferences_stored") %>"><%= sd_icon("monitor", size: 15) %>
          <span class="sd-ai-room-context-label"><%= t("ui.chat_compose.device") %></span>
          <strong data-ai-draft-target="browserName"><%= t("ui.chat_compose.current_browser") %></strong>
        </span>
      </div>

      <section class="sd-room-settings-current" aria-label="<%= t("ui.chat_compose.room_summary") %>" hidden aria-hidden="true">
        <header class="sd-room-settings-current__heading">
          <span class="sd-room-settings-current__icon" aria-hidden="true"><%= sd_icon("sliders-horizontal", size: 18) %></span>
          <strong><%= t("ui.chat_compose.room_summary") %></strong>
        </header>
      <div class="sd-room-settings-snapshot">
        <div class="sd-room-settings-snapshot__item">
          <span><%= t("ui.chat_compose.room_summary_profile") %></span>
          <strong data-ai-draft-target="roomSummaryProfile"><%= t("ui.chat_compose.quick_profile_universal") %></strong>
        </div>
        <div class="sd-room-settings-snapshot__item">
          <span><%= t("ui.chat_compose.room_summary_language") %></span>
          <strong data-ai-draft-target="roomSummaryLanguage"><%= t("ui.chat_compose.room_pref_lang_auto") %></strong>
        </div>
        <div class="sd-room-settings-snapshot__item">
          <span><%= t("ui.chat_compose.room_summary_style") %></span>
          <strong data-ai-draft-target="roomSummaryStyle"><%= t("ui.chat_compose.polish_clarity") %></strong>
        </div>
      </div>
      </section>
      <div class="sd-room-settings-content" aria-label="<%= t("ui.chat_compose.conversation_preferences") %>">
        <% if @single_room.is_private? %>
          <% instruction_latest = @single_room.ai_instruction_revisions.order(revision_number: :desc).first %>
          <% instruction_can_edit = RoomAiInstructionRevision.can_edit?(room: @single_room, user: current_user) %>
          <section class="sd-room-ai-instructions"
                   data-controller="room-ai-instructions"
                   data-room-ai-instructions-url-value="<%= room_ai_instructions_path(@single_room) %>"
                   data-room-ai-instructions-history-url-value="<%= room_ai_instructions_history_path(@single_room) %>"
                   data-room-ai-instructions-revision-value="<%= instruction_latest&.revision_number || 0 %>"
                   data-room-ai-instructions-can-edit-value="<%= instruction_can_edit %>"
                   data-room-ai-instructions-user-id-value="<%= current_user.id %>"
                   data-room-ai-instructions-room-id-value="<%= @single_room.id %>"
                   data-room-ai-instructions-copy-value="<%= t("ui.room_ai_instructions").to_json %>"
                   aria-label="<%= t("ui.room_ai_instructions.title") %>">
            <details class="sd-room-ai-instructions__fold">
              <summary class="sd-room-ai-instructions__summary">
                <span class="sd-room-ai-instructions__icon" aria-hidden="true"><%= sd_icon("file-text", size: 19) %></span>
                <span class="sd-room-ai-instructions__heading">
                  <strong><%= t("ui.room_ai_instructions.title") %></strong>
                  <small><%= t("ui.room_ai_instructions.subtitle") %></small>
                </span>
                <span class="sd-room-ai-instructions__revision" data-room-ai-instructions-target="revision">
                  <%= t("ui.room_ai_instructions.version", count: instruction_latest&.revision_number || 0) %>
                </span>
                <%= sd_icon("chevron-down", size: 17) %>
              </summary>
              <div class="sd-room-ai-instructions__body">
                
                <details class="sd-room-ai-instructions__current"
                           data-room-ai-instructions-target="currentPreview"
                           <%= "hidden" unless instruction_latest %>>
                    <summary>
                      <span><%= sd_icon("file-pen-line", size: 15) %> <%= t("ui.room_ai_instructions.current_heading") %></span>
                      <span data-room-ai-instructions-target="currentVersion">
                        <%= t("ui.room_ai_instructions.version", count: instruction_latest&.revision_number || 0) %>
                      </span>
                      <%= sd_icon("chevron-down", size: 16) %>
                    </summary>
                    <div class="sd-room-ai-instructions__current-body">
                      <pre data-room-ai-instructions-target="currentText"><%= instruction_latest&.content %></pre>
                      <% if instruction_can_edit %>
                      <button type="button" class="sd-room-ai-instructions__history-button"
                              data-action="click->room-ai-instructions#loadCurrent">
                        <%= sd_icon("pencil", size: 15) %>
                        <%= t("ui.room_ai_instructions.edit_current") %>
                      </button>
                      <% end %>
                    </div>
                  </details>
                <% if instruction_can_edit %>
                  <div class="sd-room-ai-instructions__draft-heading">
                    <label class="sd-room-ai-instructions__label" for="room-ai-instruction-text-<%= @single_room.id %>">
                      <%= t("ui.room_ai_instructions.field_new") %>
                    </label>
                    <div class="sd-room-ai-instructions__name-actions">
                      <span class="sd-room-ai-instructions__draft-name" data-room-ai-instructions-target="templateTitle">
                        <%= t("ui.room_ai_instructions.template_default", count: (instruction_latest&.revision_number || 0) + 1) %>
                      </span>
                      <input type="text" maxlength="60" autocomplete="off" hidden
                             data-room-ai-instructions-target="templateName"
                             data-action="keydown->room-ai-instructions#nameKeydown"
                             aria-label="<%= t("ui.room_ai_instructions.template_name") %>">
                      <button type="button" class="sd-room-ai-instructions__name-edit"
                              data-room-ai-instructions-target="templateEdit"
                              data-action="click->room-ai-instructions#editName"
                              aria-label="<%= t("ui.room_ai_instructions.rename_template") %>"
                              title="<%= t("ui.room_ai_instructions.rename_template") %>">
                        <%= sd_icon("pencil", size: 16) %>
                        <span><%= t("ui.room_ai_instructions.template_name") %></span>
                      </button>
                      <button type="button" class="sd-room-ai-instructions__name-save" hidden
                              data-room-ai-instructions-target="templateConfirm"
                              data-action="click->room-ai-instructions#confirmName"
                              aria-label="<%= t("ui.room_ai_instructions.confirm_template_name") %>">
                        <%= sd_icon("check", size: 16) %>
                      </button>
                    </div>
                  </div>
                <% end %>
                <textarea id="room-ai-instruction-text-<%= @single_room.id %>"
                           class="sd-room-ai-instructions__textarea"
                           data-room-ai-instructions-target="editor"
                           data-action="input->room-ai-instructions#changed"
                           maxlength="<%= RoomAiInstructionRevision::MAX_CHARS %>"
                           rows="5" autocomplete="off" spellcheck="true"
                           <%= "hidden" unless instruction_can_edit %>
                           placeholder="<%= t("ui.room_ai_instructions.placeholder") %>"
                           <%= "readonly" unless instruction_can_edit %>><%= instruction_can_edit ? "" : instruction_latest&.content %></textarea>
                <div class="sd-room-ai-instructions__meta" <%= "hidden" unless instruction_can_edit %>>
                  <span data-room-ai-instructions-target="counter" aria-live="polite"></span>
                </div>
                <div class="sd-room-ai-instructions__actions">
                  <% if instruction_can_edit %>
                    <button type="button" class="sd-room-ai-instructions__save"
                            data-room-ai-instructions-target="save"
                            data-action="click->room-ai-instructions#save" disabled>
                      <%= sd_icon("check", size: 16) %>
                      <%= t("ui.room_ai_instructions.save") %>
                    </button>
                  <% end %>
                  <button type="button" class="sd-room-ai-instructions__history-button"
                          data-room-ai-instructions-target="historyToggle"
                          data-action="click->room-ai-instructions#toggleHistory"
                          aria-expanded="false">
                    <%= sd_icon("inbox", size: 16) %>
                    <%= t("ui.room_ai_instructions.history") %>
                  </button>
                </div>
                <p class="sd-room-ai-instructions__status" data-room-ai-instructions-target="status"
                   role="status" aria-live="polite"></p>
                <div class="sd-room-ai-instructions__conflict" data-room-ai-instructions-target="conflict"
                     data-open="false" aria-hidden="true" inert>
                  <div class="sd-room-ai-instructions__conflict-body">
                    <p data-room-ai-instructions-target="conflictSummary"></p>
                    <div class="sd-room-ai-instructions__actions">
                      <button type="button" data-action="click->room-ai-instructions#rebaseDraft"
                              class="sd-room-ai-instructions__history-button">
                        <%= t("ui.room_ai_instructions.rebase") %>
                      </button>
                      <button type="button" data-action="click->room-ai-instructions#useServer"
                              class="sd-room-ai-instructions__history-button">
                        <%= t("ui.room_ai_instructions.use_server") %>
                      </button>
                    </div>
                  </div>
                </div>
                <div class="sd-room-ai-instructions__history-shell" data-room-ai-instructions-target="historyShell"
                     data-open="false" aria-hidden="true" inert>
                  <div class="sd-room-ai-instructions__history" data-room-ai-instructions-target="history"
                       aria-label="<%= t("ui.room_ai_instructions.history") %>"></div>
                </div>
              </div>
            </details>
          </section>
        <% end %>

      <section class="sd-ai-experience-profiles sd-ai-ui-section sd-ai-ui-section--quick" aria-label="<%= t("ui.chat_compose.quick_profile_title") %>">
        <div class="sd-ai-ui-heading">
          <span class="sd-ai-ui-heading__icon" aria-hidden="true"><%= sd_icon("sliders-horizontal", size: 19) %></span>
          <div><h4><%= t("ui.chat_compose.quick_profile_title") %></h4></div>
        </div>
        <div class="sd-ai-experience-profiles__choices" role="group" aria-label="<%= t("ui.chat_compose.quick_profile_title") %>">
          <% AiWorkspace::ConversationExperienceV1::PROFILES.each_key do |profile_id| %>
            <button type="button" class="sd-ai-experience-profiles__choice"
                    data-ai-draft-target="profile" data-action="click->ai-draft#chooseExperienceProfile"
                    data-profile-id="<%= profile_id %>"
                    data-profile-style="<%= AiWorkspace::ConversationExperienceV1.resolve(profile_id: profile_id).settings.fetch(:writing_style) %>"
                    data-profile-tone="<%= AiWorkspace::ConversationExperienceV1.resolve(profile_id: profile_id).settings.fetch(:tone) %>"
                    aria-pressed="<%= profile_id == "universal" %>">
              <%= t("ui.chat_compose.quick_profile_#{profile_id}") %>
            </button>
          <% end %>
        </div>
        <p class="sd-ai-experience-profiles__status sd-visually-hidden" data-ai-draft-target="profileSummary" aria-live="polite"></p>
        <div class="sd-ai-room-preference-grid">
          <label>
            <span class="sd-ai-select-caption"><%= sd_icon("globe", size: 16) %><%= t("ui.chat_compose.room_pref_language") %></span>
            <select data-controller="ui-select" data-ai-draft-target="languageSelect" data-action="change->ai-draft#changeRoomLanguage">
              <% AiWorkspace::ConversationExperienceV1::FIELD_VALUES.fetch(:language).each do |code| %>
                <option value="<%= code %>"><%= t("ui.chat_compose.room_pref_lang_#{code}") %></option>
              <% end %>
            </select>
          </label>
          <label>
            <span class="sd-ai-select-caption"><%= sd_icon("sliders-horizontal", size: 16) %><%= t("ui.chat_compose.room_pref_tone") %></span>
            <select data-controller="ui-select" data-ai-draft-target="toneSelect" data-action="change->ai-draft#changeRoomTone">
              <% AiWorkspace::ConversationExperienceV1::FIELD_VALUES.fetch(:tone).each do |code| %>
                <option value="<%= code %>"><%= t("ui.chat_compose.room_pref_tone_#{code}") %></option>
              <% end %>
            </select>
          </label>
        </div>
        <div class="sd-ai-room-preference-actions">
          <p class="sd-ai-room-preference-sync" data-ai-draft-target="roomSyncStatus" role="status" aria-live="polite"><%= t("ui.chat_compose.room_pref_status") %></p>
          <p class="sd-ai-room-preference-origin sd-visually-hidden" data-ai-draft-target="preferenceOrigin"
             data-room="<%= t("ui.account_ai_defaults.origin_room") %>"
             data-account="<%= t("ui.account_ai_defaults.origin_account") %>"
             data-system="<%= t("ui.account_ai_defaults.origin_system") %>"><%= t("ui.account_ai_defaults.origin_#{room_writing_preference ? "room" : (account_writing_preference ? "account" : "system")}") %></p>
          <button type="button" class="sd-ai-room-preference-reset"
                  data-ai-draft-target="resetRoomDefaults"
                  data-action="click->ai-draft#resetRoomWritingOverrides"
                  <%= "disabled" unless room_writing_preference %>>
            <%= sd_icon("refresh-cw", size: 15) %>
            <%= t("ui.account_ai_defaults.use_account") %>
          </button>
        </div>
      </section>
      <section class="sd-ai-room-group sd-ai-room-group--style sd-ai-ui-section sd-ai-ui-section--compact" aria-label="<%= t("ui.chat_compose.preferred_style") %>">
        <div class="sd-ai-ui-heading">
          <span class="sd-ai-ui-heading__icon" aria-hidden="true"><%= sd_icon("palette", size: 19) %></span>
          <div><h4><%= t("ui.chat_compose.writing_style") %></h4></div>
        </div>
        <details class="sd-ai-room-style-picker">
          <summary class="sd-ai-room-style-summary">
            <span><%= t("ui.chat_compose.current") %> <strong data-ai-draft-target="roomStyleLabel"><%= t("ui.chat_compose.polish_clarity") %></strong></span>
          </summary>
          <div class="sd-ai-room-presets" role="group" aria-label="<%= t("ui.chat_compose.preferred_style") %>">
          <% AiWorkspace::PresetRegistry.bundled.all.each_with_index do |preset, index| %>
            <button type="button" class="sd-ai-draft-preset" data-ai-draft-target="preset"
                    data-action="click->ai-draft#choosePreset" data-preset-id="<%= preset.id %>"
                    aria-pressed="<%= index.zero? %>" aria-label="<%= t("ui.chat_compose.#{preset.id}") %>">
              <span class="sd-ai-preset-glyph"><%= sd_icon(ai_style_icons.fetch(preset.id), size: 20) %></span>
              <span class="sd-ai-preset-name"><%= t("ui.chat_compose.#{preset.id}") %></span>
              <span class="sd-ai-preset-caption"><%= t("ui.chat_compose.desc_#{preset.id}") %></span></button>
          <% end %>
          </div>
        </details>
      </section>

      <section class="sd-ai-room-group sd-ai-room-group--options sd-ai-ui-section" aria-labelledby="ai-room-option-title">
        <div class="sd-ai-ui-heading">
          <span class="sd-ai-ui-heading__icon" aria-hidden="true"><%= sd_icon("wrench", size: 19) %></span>
          <div><h4 id="ai-room-option-title"><%= t("ui.chat_compose.assistance") %></h4></div>
        </div>
        <div class="sd-ai-room-option sd-ai-room-option--spell">
          <div class="sd-ai-room-option-line">
