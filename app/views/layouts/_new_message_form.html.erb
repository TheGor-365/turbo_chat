                        <button type="button" class="sd-ai-draft-refresh"
                                data-ai-coverage-target="next"
                                data-action="click->ai-coverage#next" hidden><%= t("ui.ai_coverage.next") %></button>
                      </div>
                    </div>
                  </div>
                  <details class="sd-ai-evidence" data-action="toggle->ai-evidence#toggleSearch"
