                       data-ai-evidence-review-url-value="<%= room_ai_evidence_reviews_path(@single_room) %>"
                       data-ai-evidence-copy-value="<%= t("ui.ai_evidence").to_json %>">
                <summary class="sd-ai-coverage__summary">
                  <%= sd_icon("filter", size: 16) %>
                  <span><strong><%= t("ui.ai_coverage.heading") %></strong>
                    <small><%= t("ui.ai_coverage.intro") %></small></span>
                </summary>
                <div class="sd-ai-coverage__body">
                  <button type="button" class="sd-ai-draft-refresh"
                          data-ai-coverage-target="refresh"
