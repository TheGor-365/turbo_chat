<% writing_room_peer = @single_room.direct_message? ? @single_room.participants.find { |entry| entry.user_id != current_user.id }&.user : nil %>
<% writing_room_label = writing_room_peer&.chat_label || (@single_room.direct_message? ? "Direct conversation" : @single_room.name) %>
<% manual_ai_available = AiWorkspace::ManualDraftGeneration.enabled? %>
<% contextual_ai_available = AiWorkspace::ContextReplyGeneration.enabled? && @single_room.is_private? %>
<% context_tasks_available = AiWorkspace::ContextTaskGeneration.enabled? && contextual_ai_available %>
<% ai_style_icons = {
  "polish_clarity" => "sparkles", "professional_client_reply" => "mail",
  "friendly" => "smile", "concise" => "filter",
  "translate_preserving_tone" => "globe", "technical_summary" => "file-text"
}.freeze %>
<div class="msg-form sd-composer-dock" data-controller="ai-draft"
     data-ai-draft-user-id="<%= current_user.id %>" data-ai-draft-room-id="<%= @single_room.id %>"
     data-ai-draft-room-path="<%= room_path(@single_room) %>"
     <% if manual_ai_available %>data-ai-draft-generate-url="<%= generate_room_ai_draft_path(@single_room) %>"<% end %>
     <% if contextual_ai_available %>
       data-ai-draft-context-status-url="<%= room_ai_context_consent_path(@single_room) %>"
       data-ai-draft-context-consent-url="<%= room_ai_context_consent_path(@single_room) %>"
       data-ai-draft-context-reply-url="<%= generate_room_ai_context_reply_path(@single_room) %>"
       data-ai-draft-context-preview-url="<%= preview_room_ai_context_path(@single_room) %>"
       data-ai-draft-review-url="<%= room_ai_deliverable_review_path(@single_room) %>"
       <% if context_tasks_available %>
         data-ai-draft-context-task-url="<%= generate_room_ai_context_task_path(@single_room) %>"
       <% end %>
     <% end %>
     data-action="turbo:submit-end->ai-draft#submitEnd">
  <div class="sd-ai-sheet-backdrop" data-ai-draft-target="backdrop" data-action="click->ai-draft#close" aria-hidden="true" hidden></div>
  <%= form_with model: [@single_room, @message], class: "message-composer sd-message-composer",
      data: {
        controller: "message-composer",
        action: "submit->message-composer#beforeSubmit submit->typing-indicator#stopTyping turbo:submit-start->message-composer#submitStart turbo:submit-end->message-composer#submitEnd"
      } do |f| %>
    <div class="composer-drop-hint" aria-hidden="true">Drop files to attach</div>
    <div class="composer-reply" data-message-composer-target="replyPreview" hidden aria-label="Replying to message">
      <span data-message-composer-target="replyPreviewText"></span>
      <button type="button" class="sd-icon-button sd-quiet-action"
        data-action="click->message-composer#clearReply" aria-label="Cancel reply" title="Cancel reply">
        <%= sd_icon("x", size: 18) %>
      </button>
    </div>
    <%= f.hidden_field :reply_to_id, value: nil, data: { message_composer_target: "replyTo" } %>
    <div class="composer-previews" data-message-composer-target="previews" role="list" aria-label="Selected attachments" hidden></div>
    <div class="sd-ai-room-strip" role="group" aria-label="Writing tools status for this room">
      <span class="sd-ai-room-state" data-ai-draft-target="aiIndicator" title="<%= manual_ai_available ? 'Manual Grok suggestion available with confirmation' : 'AI correction unavailable' %>">
        <%= sd_icon("sparkles", size: 13) %> <%= manual_ai_available ? "AI MANUAL" : "AI OFF" %>
      </span>
      <span class="sd-ai-room-state" data-ai-draft-target="autoIndicator" title="Auto correction unavailable">
        <%= sd_icon("zap", size: 13) %> AUTO OFF
      </span>
      <span class="sd-ai-room-state sd-ai-room-spell" data-ai-draft-target="spellIndicator" data-enabled="true"
            title="Browser spelling hints (not AI correction)">
        <%= sd_icon("check", size: 13) %> <span data-ai-draft-target="spellIndicatorLabel">SPELL ON</span>
      </span>
      <% if contextual_ai_available %>
        <span class="sd-ai-consent-summary" data-ai-draft-target="consentSummary"
              aria-live="polite" title="Room AI permissions, updated while the tab is active">
          <%= sd_icon("shield-check", size: 13) %>
          <span data-ai-draft-target="consentCount">AI context · checking</span>
        </span>
        <span class="sd-ai-consent-compact" data-ai-draft-target="consentCompact"
              role="list" aria-label="Each participant's AI context permission"></span>
      <% end %>
      <span class="sd-ai-room-preset" data-ai-draft-target="presetBadge"
            title="Saved writing preference">Polish / Clarity</span>
      <button type="button" class="sd-ai-quick-undo" data-ai-draft-target="quickUndo"
              data-action="click->ai-draft#undo" hidden aria-label="Undo applied AI edit"
              title="Undo applied AI edit">
        <%= sd_icon("refresh-cw", size: 14) %> Undo AI edit
      </button>
    </div>
    <div class="composer-controls">
      <label for="message_attachments" class="composer-attach sd-icon-button sd-quiet-action"
             title="Attach files" aria-label="Choose files to attach" tabindex="0"
             role="button" data-action="keydown.enter->message-composer#openFiles keydown.space->message-composer#openFiles">
        <%= sd_icon("paperclip", size: 19) %>
      </label>
      <%= f.file_field :attachments, id: "message_attachments", multiple: true,
          accept: "image/jpeg,image/png,image/webp,application/pdf,text/plain,text/markdown,audio/webm,video/webm,.webm,.md,.markdown,.txt",
          class: "composer-file-input visually-hidden",
          data: { message_composer_target: "files", action: "change->message-composer#filesSelected" } %>
      <button type="button" id="ai-draft-toggle"
              class="sd-icon-button sd-quiet-action sd-ai-draft-toggle"
              title="Edit unsent message" aria-label="Edit unsent message"
              aria-controls="ai-draft-panel ai-room-settings" aria-expanded="false"
              data-ai-draft-target="toggle" data-action="click->ai-draft#toggle">
        <%= sd_icon("sparkles", size: 18) %>
      </button>
      <button type="button" class="sd-icon-button sd-quiet-action" title="Take photo" aria-label="Take photo"
        data-action="click->message-composer#openCamera">
        <%= sd_icon("camera", size: 19) %>
      </button>

      <button type="button" class="sd-icon-button sd-quiet-action" title="Record voice message"
              aria-label="Record voice message" data-message-composer-target="voiceButton"
              data-action="click->message-composer#startVoice">
        <%= sd_icon("mic", size: 19) %>
      </button>

      <%= f.text_area :body, id: "chat-text", class: "sd-composer-input msg-content sd-composer-multiline",
          rows: 1, placeholder: "Write a message...", autocomplete: "off",
          data: { message_composer_target: "body", ai_draft_target: "body", typing_indicator_target: "body",
                  action: "input->message-composer#resizeBody input->typing-indicator#changed input->ai-draft#draftChanged keydown->message-composer#submitOnEnter" },
          aria: { label: "Message" } %>
      <button type="submit" class="composer-send sd-icon-button sd-icon-button--accent"
              aria-label="Send" title="Send" data-message-composer-target="submit">
        <%= sd_icon("send", size: 20) %>
        <span class="sd-visually-hidden">Send</span>
      </button>
    </div>
    <dialog id="ai-room-settings" class="sd-ai-room-settings"
             data-ai-draft-target="settingsPanel" aria-labelledby="ai-room-settings-title"
             role="dialog" aria-modal="true" data-action="cancel->ai-draft#closeSettings click->ai-draft#dismissOnBackdrop" hidden>
      <div class="sd-ai-workspace-topbar">
        <div class="sd-ai-mode-nav" role="group" aria-label="Writing tools view">
          <button type="button" aria-pressed="false" data-action="click->ai-draft#showEditor">
            <%= sd_icon("pencil", size: 15) %> Edit draft
          </button>
          <button type="button" aria-pressed="true" class="is-active" data-action="click->ai-draft#showSettings">
            <%= sd_icon("settings", size: 15) %> Room settings
          </button>
        </div>
        <button type="button" class="sd-icon-button sd-quiet-action sd-ai-sheet-close"
                aria-label="Close writing settings" title="Close writing settings"
                data-action="click->ai-draft#closeSettings"><%= sd_icon("x", size: 18) %></button>
      </div>
      <h3 id="ai-room-settings-title" class="sd-visually-hidden">Room settings</h3>
      <div class="sd-ai-room-context" aria-label="Preference scope">
        <span title="Current conversation"><%= sd_icon("messages", size: 15) %>
          <span class="sd-ai-room-context-label">Room:</span>
          <strong <%= "data-profile-label-user-id=#{writing_room_peer.id}" if writing_room_peer %>><%= writing_room_label %></strong>
        </span>
        <span title="Preferences are stored on this device"><%= sd_icon("monitor", size: 15) %>
          <span class="sd-ai-room-context-label">Device:</span>
          <strong data-ai-draft-target="browserName">Current browser</strong>
        </span>
      </div>

      <section class="sd-chat-simple-preferences" aria-label="Chat display preferences">
        <label class="sd-chat-setting-switch">
          <input type="checkbox" role="switch" data-simple-chat-target="detailToggle"
                 data-action="change->simple-chat#change"
                 aria-label="Show detailed writing tools">
          <span><strong>Detailed writing tools</strong>
            <small>Off by default · Show AI, spellcheck, context and preset status above the message box</small></span>
        </label>
      </section>

      <section class="sd-chat-translation-settings" aria-labelledby="incoming-translation-heading">
        <div class="sd-chat-translation-settings__heading">
          <strong id="incoming-translation-heading"><%= sd_icon("languages", size: 16) %> Перевод входящих</strong>
          <small>Читать сообщения на своём языке. Оригинал всегда доступен.</small>
        </div>
        <label class="sd-chat-setting-switch">
          <input type="checkbox" role="switch" data-incoming-translation-target="toggle"
                 data-action="change->incoming-translation#toggle"
                 aria-label="Enable incoming message translation">
          <span><strong>Включить перевод</strong>
            <small>Только в этом браузере · Без платных AI-вызовов</small></span>
        </label>
        <label class="sd-chat-translation-settings__select">
          <span>Мой язык сообщений</span>
          <select data-incoming-translation-target="locale"
                  data-action="change->incoming-translation#changeLocale" aria-label="My message language">
            <option value="ru">Русский</option>
            <option value="en">English</option>
            <option value="es">Español</option>
            <option value="fr">Français</option>
            <option value="de">Deutsch</option>
            <option value="pt">Português</option>
            <option value="uk">Українська</option>
            <option value="ar">العربية</option>
            <option value="zh">中文</option>
            <option value="ja">日本語</option>
            <option value="hy">Հայերեն (пока без браузерной модели)</option>
          </select>
        </label>
        <details class="sd-chat-translation-settings__advanced">
          <summary>Если язык отправителя определяется неверно</summary>
          <label class="sd-chat-translation-settings__select">
            <span>Язык входящих сообщений</span>
            <select data-incoming-translation-target="source"
                    data-action="change->incoming-translation#changeSource"
                    aria-label="Incoming source language">
              <option value="auto">Определять автоматически</option>
              <option value="en">English</option>
              <option value="ru">Русский</option>
              <option value="es">Español</option>
              <option value="fr">Français</option>
              <option value="de">Deutsch</option>
              <option value="pt">Português</option>
              <option value="uk">Українська</option>
              <option value="ar">العربية</option>
              <option value="zh">中文</option>
              <option value="ja">日本語</option>
            </select>
          </label>
        </details>
        <p class="sd-chat-translation-settings__status" data-incoming-translation-target="status"
           role="status" aria-live="polite">Перевод выключен.</p>
        <p class="sd-chat-translation-settings__note">
          В Chrome перевод выполняется на устройстве. При первом включении браузер
          может загрузить языковые модели. Неподдерживаемые языки показываются в оригинале.
        </p>
      </section>
      <section class="sd-ai-room-group sd-ai-room-group--style" aria-label="Preferred writing style">
        <details class="sd-ai-room-style-picker">
          <summary class="sd-ai-room-style-summary">
            <span>Current: <strong data-ai-draft-target="roomStyleLabel">Polish / Clarity</strong></span>
          </summary>
          <div class="sd-ai-room-presets" role="group" aria-label="Preferred writing style">
          <% AiWorkspace::PresetRegistry.bundled.all.each_with_index do |preset, index| %>
            <button type="button" class="sd-ai-draft-preset" data-ai-draft-target="preset"
                    data-action="click->ai-draft#choosePreset" data-preset-id="<%= preset.id %>"
                    aria-pressed="<%= index.zero? %>" aria-label="<%= preset.label %>">
              <span class="sd-ai-preset-glyph"><%= sd_icon(ai_style_icons.fetch(preset.id), size: 20) %></span>
              <span class="sd-ai-preset-name"><%= preset.label %></span></button>
          <% end %>
          </div>
        </details>
      </section>
      <section class="sd-ai-room-group sd-ai-room-group--options" aria-labelledby="ai-room-option-title">
        <h4 id="ai-room-option-title"><%= sd_icon("wrench", size: 16) %> Writing assistance</h4>
        <div class="sd-ai-room-option sd-ai-room-option--spell">
          <div class="sd-ai-room-option-line">
            <span class="sd-ai-room-option-title"><%= sd_icon("check", size: 17) %> Spelling hints</span>
            <button type="button" class="sd-ai-room-switch" role="switch"
                    aria-checked="true" aria-label="Turn spelling hints off"
                    title="Local browser spelling hints (dictionary-dependent)"
                    data-ai-draft-target="spellToggle" data-action="click->ai-draft#toggleSpellcheck">
              <span class="sd-ai-room-switch-track" aria-hidden="true"><span></span></span>
              <span data-ai-draft-target="spellState">ON</span>
            </button>
          </div>
          <details class="sd-ai-option-disclosure sd-ai-option-disclosure--spell">
            <summary class="sd-ai-option-chevron" aria-label="Show spelling hints explanation"
                     title="About spelling hints"><%= sd_icon("chevron-down", size: 16) %></summary>
            <div class="sd-ai-option-description-body">
              <p class="sd-ai-room-option-description">Built-in browser dictionary. No AI, network request or charge.</p>
            </div>
          </details>
        </div>
        <% if contextual_ai_available %>
          <div class="sd-ai-room-option sd-ai-room-option--smart">
            <div class="sd-ai-room-option-line">
              <span class="sd-ai-room-option-title"><%= sd_icon("sparkles", size: 17) %> Smart replies</span>
              <button type="button" class="sd-ai-room-switch" role="switch" disabled
                      aria-checked="false" aria-label="Allow my room messages as AI context"
                      data-ai-draft-target="smartReplyToggle"
                      data-action="click->ai-draft#toggleSmartReplies">
                <span class="sd-ai-room-switch-track" aria-hidden="true"><span></span></span>
                <span data-ai-draft-target="smartReplyState">OFF</span>
              </button>
            </div>
            <p data-ai-draft-target="smartReplyStatus" role="status" aria-live="polite">
              Checking consent…
            </p>
            <section class="sd-ai-members-permission" aria-label="Each member's AI permission">
              <h5 class="sd-ai-members-title"><%= sd_icon("users", size: 15) %> Members' AI permissions
                <span>Read-only status · refreshed automatically</span>
              </h5>
              <ul class="sd-ai-member-list" data-ai-draft-target="consentMembers">
                <li>Checking members…</li>
              </ul>
            </section>
            <details class="sd-ai-option-disclosure sd-ai-option-disclosure--smart">
              <summary class="sd-ai-option-chevron" aria-label="Show Smart replies explanation"
                       title="About Smart replies"><%= sd_icon("chevron-down", size: 16) %></summary>
              <div class="sd-ai-option-description-body">
                <p class="sd-ai-smart-consent-note">
                  Allows context processing of this room, including older messages, only after every current member consents.
                  No AI request runs until you explicitly click Generate. Permission is revocable.
                </p>
                <p class="sd-ai-members-note">Only your own switch can be changed here. If someone is OFF, everyone can still chat and edit their own draft, but shared-context AI is blocked.</p>
              </div>
            </details>
          </div>
        <% else %>
          <div class="sd-ai-room-option sd-ai-context-unavailable" role="status">
            <p><strong>Smart replies and conversation tasks unavailable.</strong>
              <% if @single_room.is_private? %>
                Context AI is disabled in this environment. Your own draft editor remains available.
              <% else %>
                This is a public room. Its history cannot be sent to xAI. Use a private conversation with consent from every participant for contextual AI.
              <% end %>
            </p>
          </div>
        <% end %>
        <div class="sd-ai-room-option sd-ai-room-option--auto">
          <div class="sd-ai-room-option-line">
            <span class="sd-ai-room-option-title"><%= sd_icon("zap", size: 17) %> Auto correction</span>
            <button type="button" class="sd-ai-room-switch sd-ai-room-switch--locked"
                    role="switch" aria-checked="false" aria-label="Auto correction unavailable"
                    aria-describedby="ai-room-auto-explanation"
                    data-action="click->ai-draft#autoUnavailable"
                    title="Automatic AI correction is not implemented; manual requests protect privacy and budget">
              <span class="sd-ai-room-switch-track" aria-hidden="true"><span></span></span>
              <span>OFF</span>
            </button>
          </div>
          <details class="sd-ai-option-disclosure sd-ai-option-disclosure--auto">
            <summary class="sd-ai-option-chevron" aria-label="Show auto correction explanation"
                     title="About auto correction"><%= sd_icon("chevron-down", size: 16) %></summary>
            <div class="sd-ai-option-description-body">
              <p id="ai-room-auto-explanation"><%= sd_icon("lock", size: 13) %> <%= manual_ai_available ? "Automatic AI editing is not implemented. Use Edit draft for explicit requests and review before Send." : "Automatic AI editing is not implemented." %></p>
            </div>
          </details>
        </div>
      </section>
      <p class="sd-ai-room-feedback" role="status" aria-live="polite" data-ai-draft-target="roomFeedback"></p>
    </dialog>
    <dialog id="ai-draft-panel" class="sd-ai-draft-panel"
             data-ai-draft-target="panel" aria-labelledby="ai-draft-title"
             role="dialog" aria-modal="true" data-action="cancel->ai-draft#close click->ai-draft#dismissOnBackdrop" hidden>
      <div class="sd-ai-workspace-topbar">
        <div class="sd-ai-mode-nav" role="group" aria-label="Writing tools view">
          <button type="button" class="is-active" aria-pressed="true" data-action="click->ai-draft#showEditor">
            <%= sd_icon("pencil", size: 15) %> Edit draft
          </button>
          <button type="button" aria-pressed="false" data-action="click->ai-draft#showSettings">
            <%= sd_icon("settings", size: 15) %> Room settings
          </button>
        </div>
        <button type="button" class="sd-icon-button sd-quiet-action sd-ai-sheet-close"
                title="Close draft review" aria-label="Close draft review"
                data-action="click->ai-draft#close"><%= sd_icon("x", size: 18) %></button>
      </div>
      <h3 id="ai-draft-title" class="sd-visually-hidden">Edit draft</h3>
      <div class="sd-ai-room-context sd-ai-draft-context" aria-label="Message recipient and sending status">
        <span title="Message recipient"><%= sd_icon(@single_room.private_group? ? "users" : "user", size: 15) %>
          <span class="sd-ai-room-context-label">To:</span>
          <strong <%= "data-profile-label-user-id=#{writing_room_peer.id}" if writing_room_peer %>><%= writing_room_label %></strong>
        </span>
        <span title="Conversation visibility"><%= sd_icon(@single_room.is_private? ? "lock" : "lock-open", size: 15) %>
          <span><%= @single_room.private_group? ? "Private group" : (@single_room.is_private? ? "Private chat" : "Public room") %></span>
        </span>
        <% if @single_room.private_group? %>
          <span title="Current room members"><%= sd_icon("users", size: 15) %>
            <strong><%= @single_room.participants.count %></strong>
          </span>
        <% end %>
        <span title="AI suggestions are never sent automatically"><%= sd_icon("shield-check", size: 15) %>
          <span>Review before Send</span>
        </span>
      </div>
      <details class="sd-ai-style-details" data-ai-draft-target="styleDetails">
        <summary class="sd-ai-style-summary">
          <span><%= sd_icon("palette", size: 15) %> Style</span>
          <strong data-ai-draft-target="styleLabel">Polish / Clarity</strong>
        </summary>
        <div class="sd-ai-draft-presets" role="group" aria-label="Built-in draft presets">
          <% AiWorkspace::PresetRegistry.bundled.all.each_with_index do |preset, index| %>
            <button type="button" class="sd-ai-draft-preset" data-ai-draft-target="preset"
                    data-action="click->ai-draft#choosePreset"
                    data-preset-id="<%= preset.id %>" aria-pressed="<%= index.zero? %>" aria-label="<%= preset.label %>">
              <span class="sd-ai-preset-glyph"><%= sd_icon(ai_style_icons.fetch(preset.id), size: 20) %></span>
              <span class="sd-ai-preset-name"><%= preset.label %></span></button>
          <% end %>
        </div>
      </details>
      <div class="sd-ai-translation-controls" data-ai-draft-target="translationControls" hidden>
        <label for="ai-draft-target-locale"><%= sd_icon("globe", size: 16) %> Translate to</label>
        <select id="ai-draft-target-locale" data-ai-draft-target="targetLocale"
                data-action="change->ai-draft#changeTargetLocale" disabled
                aria-label="Target language for translation">
          <option value="">Choose language</option>
          <option value="en">English</option>
          <option value="ru">Русский</option>
          <option value="hy">Հայերեն</option>
        </select>
      </div>
      <div class="sd-ai-draft-result" data-ai-draft-target="result" hidden>
        <div class="sd-ai-compare-original" data-ai-draft-target="comparison" hidden>
          <span class="sd-ai-compare-tag">Before</span>
          <p data-ai-draft-target="originalText"></p>
        </div>
        <div class="sd-ai-editable-column">
          <label for="ai-draft-edit" class="sd-ai-draft-edit-label">
            <%= sd_icon("file-pen-line", size: 15) %> Editable working copy
            <span data-ai-draft-target="editorLabel" class="sd-ai-compare-tag">Draft</span>
          </label>
          <textarea id="ai-draft-edit" class="sd-ai-draft-editor" rows="1" maxlength="5000"
                    spellcheck="true" data-ai-draft-target="editor"
                    data-action="input->ai-draft#editWorking" aria-describedby="ai-draft-caption"></textarea>
          <p data-ai-draft-target="counter" class="sd-ai-draft-counter"></p>
        </div>
      </div>
      <details class="sd-ai-deliverable-preview" data-ai-draft-target="preview" hidden>
        <summary class="sd-ai-deliverable-preview__summary">
          <strong>Formatted Preview</strong>
          <span>Editable · Not sent</span>
        </summary>
        <div class="sd-ai-review-handoff">
          <button type="button" class="sd-ai-review-handoff__button"
                  data-ai-draft-target="reviewDocumentButton"
                  data-action="click->ai-draft#reviewDocument"
                  title="Review document and its source messages in a separate tab"
                  aria-label="Review structured document and sources" hidden disabled>
            <%= sd_icon("check-check", size: 17) %>
            <span>Review document</span>
            <%= sd_icon("arrow-up-right", size: 15) %>
          </button>
          <span class="sd-ai-review-handoff__note">Check claims and sources · Nothing approved or sent</span>
        </div>
        <div class="sd-ai-deliverable-preview__body sd-message-rich"
             data-ai-draft-target="previewBody" aria-label="Formatted result before sending"></div>
        <nav class="sd-ai-deliverable-preview__sources" data-ai-draft-target="previewSources"
             aria-label="Verified room message sources" hidden></nav>
        <div class="sd-ai-structure-notice" data-ai-draft-target="structuredReview" role="status" aria-live="polite" hidden></div>
        <div class="sd-ai-deliverable-preview__actions">
          <button type="button" class="sd-ai-draft-refresh" data-ai-draft-target="copyButton"
                  data-action="click->ai-draft#copyDocument" hidden>Copy</button>
          <button type="button" class="sd-ai-draft-refresh" data-ai-draft-target="exportButton"
                  data-action="click->ai-draft#exportDocument" hidden>Export .md</button>
          <span role="status" aria-live="polite" data-ai-draft-target="previewFeedback"></span>
        </div>
      </details>
      <p class="sd-ai-draft-feedback" role="status" aria-live="polite" data-ai-draft-target="status"></p>
      <% if manual_ai_available %>
        <section class="sd-ai-manual-generate" aria-label="Manual Grok suggestion">
          <button type="button" class="sd-ai-generate-button" data-ai-draft-target="generateButton"
                  data-action="click->ai-draft#generate" disabled>
            <%= sd_icon("sparkles", size: 16) %> <span data-ai-draft-target="generateLabel">Improve with Grok</span>
          </button>
        </section>
      <% end %>
      <% if contextual_ai_available %>
        <section class="sd-ai-reply-generate" aria-label="Contextual reply suggestion">
          <p class="sd-ai-context-availability" role="status" aria-live="polite"
             data-ai-draft-target="contextAvailability">Checking room permissions…</p>
          <details class="sd-ai-custom-instructions">
            <summary class="sd-ai-custom-instructions__summary">
              <%= sd_icon("file-pen-line", size: 15) %> Own task / My templates
              <span>On this device</span>
            </summary>
            <div class="sd-ai-custom-instructions__content">
              <label for="ai-custom-instruction">Custom instruction for contextual AI</label>
              <textarea id="ai-custom-instruction" rows="3" maxlength="700"
                        data-ai-draft-target="customHint"
                        data-action="input->ai-draft#editCustomHint"
                        placeholder="e.g. Organize requirements and mark missing deadlines To confirm."
                        aria-describedby="ai-custom-instruction-note"></textarea>
              <p id="ai-custom-instruction-note">Optional author note (not a system instruction). Replaces the working-copy note when filled.
                It is sent with limited approved room excerpts only when you explicitly click a Grok action.
                Templates store instructions only on this device. Do not enter private messages, personal data or secrets.</p>
              <div class="sd-ai-custom-instructions__save">
                <label for="ai-custom-template-name">Template name</label>
                <input id="ai-custom-template-name" type="text" maxlength="60"
                       data-ai-draft-target="templateName" placeholder="e.g. Client scope review">
                <button type="button" class="sd-ai-draft-refresh" data-action="click->ai-draft#saveLocalTemplate">Save template</button>
                <button type="button" class="sd-ai-draft-refresh" data-action="click->ai-draft#newLocalTemplate">New</button>
              </div>
              <ul class="sd-ai-custom-instructions__list" data-ai-draft-target="templateList"
                  aria-label="My local instruction templates"></ul>
              <p class="sd-ai-custom-instructions__feedback" data-ai-draft-target="templateFeedback"
                 role="status" aria-live="polite"></p>
            </div>
          </details>
          <details class="sd-ai-source-review">
            <summary class="sd-ai-source-review__summary">
              <%= sd_icon("search", size: 14) %> Review AI sources
              <span>Local · no Grok</span>
            </summary>
            <div class="sd-ai-source-review__contents">
              <button type="button" class="sd-ai-draft-refresh" data-ai-draft-target="sourceReviewButton"
                      data-action="click->ai-draft#reviewSources" disabled>Review sources</button>
              <p role="status" aria-live="polite" data-ai-draft-target="sourceReviewStatus">
                Inspect up to nine consent-approved excerpts. Sources may change when Generate is clicked.
              </p>
              <ol class="sd-ai-source-review__list" data-ai-draft-target="sourceReviewList"></ol>
            </div>
          </details>
          <button type="button" class="sd-ai-generate-button" data-ai-draft-target="replyButton"
                  data-action="click->ai-draft#suggestReply" disabled>
            <%= sd_icon("messages", size: 16) %>
            <span data-ai-draft-target="replyLabel">Suggest reply with Grok</span>
          </button>
          <% if context_tasks_available %>
          <div class="sd-ai-context-task-controls" data-ai-draft-target="taskControls">
            <details class="sd-ai-task-picker" data-ai-draft-target="taskPicker">
              <summary class="sd-ai-task-picker-trigger" aria-label="Work with conversation: choose a task">
                <%= sd_icon("messages", size: 16) %>
                <span>Work with conversation</span>
                <strong data-ai-draft-target="taskSummaryLabel">Choose a task</strong>
                <%= sd_icon("chevron-down", size: 14) %>
              </summary>
              <div class="sd-ai-task-picker-menu" role="group" aria-label="Conversation tasks">
                <% [
                  ["conversation_summary", "Conversation summary", "file-text"],
                  ["action_items", "Action items", "check-check"],
                  ["client_brief", "Client brief", "file-text"],
                  ["client_proposal", "Client proposal", "mail"],
                  ["content_outline", "Content outline", "menu"]
                ].each do |kind, label, icon_name| %>
                  <button type="button" class="sd-ai-task-choice" aria-pressed="false"
                          data-ai-draft-target="taskOption" data-task-kind="<%= kind %>"
                          data-action="click->ai-draft#chooseContextTask">
                    <%= sd_icon(icon_name, size: 15) %>
                    <span><%= label %></span>
                  </button>
                <% end %>
              </div>
            </details>
            <select id="ai-context-task-kind" data-ai-draft-target="taskSelect"
                    data-action="change->ai-draft#changeContextTask"
                    aria-hidden="true" tabindex="-1" hidden>
              <option value="">Choose a task</option>
              <option value="conversation_summary">Conversation summary</option>
              <option value="action_items">Action items</option>
              <option value="client_brief">Client brief</option>
              <option value="client_proposal">Client proposal</option>
              <option value="content_outline">Content outline</option>
            </select>
            <label class="sd-ai-brief-spend-consent" data-ai-draft-target="briefSpendConsentRow" hidden>
              <input type="checkbox" data-ai-draft-target="briefSpendConsent"
                     data-action="change->ai-draft#updateButtons" autocomplete="off">
              <span>Authorize one paid Client Brief request. Up to $0.10 is reserved from the local development budget; actual provider charges may differ. No automatic Send or approval.</span>
            </label>
            <button type="button" class="sd-ai-draft-refresh sd-ai-context-task-generate"
                    data-ai-draft-target="taskButton"
                    data-action="click->ai-draft#generateContextTask" disabled>
              <%= sd_icon("sparkles", size: 15) %> <span data-ai-draft-target="taskLabel">Generate with Grok</span>
            </button>
          </div>
          <%= link_to new_room_ai_deliverable_review_path(@single_room),
            class: "sd-h4-composer-link",
            title: "Open manual structured document review", data: { turbo: false } do %>
            <%= sd_icon("check-check", size: 16) %>
            <span>Review brief / proposal / summary</span>
            <%= sd_icon("arrow-up-right", size: 15) %>
          <% end %>
          <% else %>
            <p>Conversation tasks are disabled in this environment.</p>
          <% end %>
        </section>
      <% else %>
        <section class="sd-ai-reply-generate sd-ai-context-unavailable" aria-label="Context AI availability">
          <p role="status">
            <strong>Smart replies and conversation tasks unavailable.</strong>
            <% if @single_room.is_private? %>
              Context AI is disabled in this environment. Manual draft editing remains available.
            <% else %>
              This is a public room. Its history cannot be sent to xAI. Use a private conversation with consent from every participant.
            <% end %>
          </p>
        </section>
      <% end %>
      <details class="sd-ai-provider-details">
        <summary>Details</summary>
        <p>For draft editing, write your own message first. Contextual suggestions can start with an empty message field.</p>
        <% if contextual_ai_available %>
          <p data-ai-draft-target="contextSources" hidden></p>
          <details class="sd-ai-evidence-review" data-ai-draft-target="evidenceReview" hidden>
            <summary data-ai-draft-target="evidenceReviewSummary">Evidence review</summary>
            <p>Structural signals only. Linked citations do not prove factual accuracy, client approval or agreed obligations.</p>
            <ol data-ai-draft-target="evidenceReviewIssues"></ol>
          </details>
        <% end %>
        <% if manual_ai_available %>
          <p>All six manual Grok styles process only your own unsent draft. Translation requires choosing English, Russian or Armenian explicitly.</p>
          <p>Clicking a Grok button approves one paid request; the draft stays unsent until you choose Send.
             Using a draft style sends only your own unsent draft to xAI.
             Smart reply and conversation tasks are separate actions: if each current room member consents,
             they send up to nine bounded text excerpts and an optional author note.
             Files, other rooms and messages by former members are excluded.
             xAI may log API requests. No chat message is sent automatically.</p>
          <p>Maximum local reservation $0.10 per request; limits $0.30 per user/day,
             $1 per user/month and $2 per installation/month. Failed requests may
             retain their reservation. Actual provider billing may differ.</p>
          <p data-ai-draft-target="providerCost" hidden></p>
        <% else %>
          <p>Manual Grok is not available in this environment. Automatic correction remains off.</p>
        <% end %>
      </details>
      <div class="sd-ai-draft-action-row">
        <button type="button" class="sd-ai-draft-refresh" aria-label="Reload from message" title="Reload from message" data-action="click->ai-draft#refresh">
          <%= sd_icon("refresh-cw", size: 16) %> Reload
        </button>
        <button type="button" class="sd-ai-draft-refresh" data-ai-draft-target="previewDraftButton"
                data-action="click->ai-draft#previewLocalDraft">
          <%= sd_icon("eye", size: 15) %> Preview locally
        </button>
        <button type="button" class="sd-ai-draft-apply" data-ai-draft-target="apply"
                data-action="click->ai-draft#apply" disabled>
          <%= sd_icon("check", size: 16) %> Apply to message
        </button>
        <button type="button" class="sd-ai-draft-undo" data-ai-draft-target="undo"
                data-action="click->ai-draft#undo" hidden>
          <%= sd_icon("refresh-cw", size: 15) %> Undo applied edit
        </button>
      </div>
      <p id="ai-draft-caption" class="sd-ai-draft-disclaimer"><%= sd_icon("info", size: 14) %> Send stays manual.</p>
    </dialog>
    <div class="composer-camera" data-message-composer-target="cameraPanel" hidden>
      <video data-message-composer-target="cameraVideo" autoplay muted playsinline aria-label="Camera preview"></video>
      <div class="d-flex gap-2 py-2">
        <button type="button" class="btn btn-primary" data-message-composer-target="photoButton"
                data-action="click->message-composer#capturePhoto">Capture photo</button>
        <button type="button" class="btn btn-outline-light" data-message-composer-target="clipRecord"
                data-action="click->message-composer#startClip">Record silent video</button>
        <button type="button" class="btn btn-outline-light" data-message-composer-target="cameraCancel"
                data-action="click->message-composer#closeCamera">Cancel camera</button>
        <button type="button" class="btn btn-primary" data-message-composer-target="clipStop"
                data-action="click->message-composer#stopClip" hidden>Stop video</button>
        <button type="button" class="btn btn-outline-light" data-message-composer-target="clipDiscard"
                data-action="click->message-composer#discardClip" hidden>Discard video</button>
        <span data-message-composer-target="clipStatus" role="status" aria-live="polite" hidden></span>
      </div>
    </div>
    <div class="composer-voice" data-message-composer-target="voicePanel" hidden>
      <span data-message-composer-target="voiceStatus" role="status" aria-live="polite">Recording 00:00</span>
      <button type="button" class="btn btn-sm btn-primary" data-message-composer-target="voiceStop"
              data-action="click->message-composer#stopVoice">Stop recording</button>
      <button type="button" class="btn btn-sm btn-outline-light"
              data-action="click->message-composer#discardVoice">Discard recording</button>
    </div>
    <div class="composer-feedback" data-message-composer-target="feedback" role="status" aria-live="polite" hidden></div>
  <% end %>
</div>
