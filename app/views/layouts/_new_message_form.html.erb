                  <p class="sd-ai-coverage__status" role="status" aria-live="polite"
                     data-ai-coverage-target="status"></p>
                  <div class="sd-ai-coverage__results" data-ai-coverage-target="results" hidden>
                    <div class="sd-ai-coverage__metrics" data-ai-coverage-target="metrics"></div>
                    <div class="sd-ai-coverage__details">
                      <div>
                        <h5><%= t("ui.ai_coverage.exclusions_title") %></h5>
                        <ul data-ai-coverage-target="exclusions"></ul>
                      </div>
                      <div>
                        <h5><%= t("ui.ai_coverage.source_title") %></h5>
                        <ol data-ai-coverage-target="sources"></ol>
