<%# Shared bottom navigation for authenticated messenger surfaces.
    Active tab is based on the server route, never browser storage. %>
<nav class="sd-mobile-bottom-nav<%= " sd-mobile-bottom-nav--activity" if local_assigns[:active] == "activity" %>"
     aria-label="<%= t("ui.nav.main") %>">
  <% [
    ["chats", root_path, "messages", t("ui.nav.conversations")],
    ["inbox", rooms_path, "search", t("ui.home.shortcut_find")],
    ["activity", notifications_path, "bell", t("ui.mobile_nav.history")],
    ["profile", edit_user_registration_path, "user", t("ui.mobile_nav.profile")]
  ].each do |name, href, glyph, title| %>
    <%= link_to href, aria: { current: ("page" if local_assigns[:active] == name) } do %>
      <%= sd_icon(glyph, size: 21) %><span><%= title %></span>
    <% end %>
  <% end %>
</nav>
