<div class="sd-auth-page">
  <header class="sd-auth-heading">
    <span class="sd-account-section-icon"><%= sd_icon("log-in", size: 22) %></span>
    <h1>Log in</h1>
    <p>Return to your conversations and private workspace.</p>
  </header>
  <%= render "devise/shared/feedback" %>
  <%= form_for(resource, as: resource_name, url: session_path(resource_name),
    html: { class: "sd-auth-form", data: { turbo: false } }) do |f| %>
    <div class="sd-account-fields">
      <div class="sd-account-field">
        <%= f.label :email, "Email" %>
        <%= f.email_field :email, class: "sd-account-input", autofocus: true,
          autocomplete: "email", required: true %>
      </div>
      <div class="sd-account-field">
        <%= f.label :password, "Password" %>
        <%= f.password_field :password, class: "sd-account-input",
          autocomplete: "current-password", required: true %>
      </div>
    </div>
    <% if devise_mapping.rememberable? %>
      <div class="sd-auth-remember">
        <%= f.check_box :remember_me %>
        <%= f.label :remember_me, "Remember me" %>
      </div>
    <% end %>
    <%= f.submit "Log in", class: "sd-account-primary" %>
  <% end %>
  <div class="sd-auth-links">
    <%= render "devise/shared/links" %>
  </div>
</div>
