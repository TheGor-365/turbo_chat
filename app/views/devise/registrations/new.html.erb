<div class="sd-auth-page">
  <header class="sd-auth-heading">
    <span class="sd-account-section-icon"><%= sd_icon("user", size: 22) %></span>
    <h1>Sign up</h1>
    <p>Create your local Turbo Chat account. Your login email is private.</p>
  </header>
  <%= form_for(resource, as: resource_name, url: registration_path(resource_name),
    html: { class: "sd-auth-form" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>
    <div class="sd-account-fields">
      <div class="sd-account-field">
        <%= f.label :display_name, "Display name (optional)" %>
        <%= f.text_field :display_name, class: "sd-account-input",
          maxlength: 48, autocomplete: "nickname", placeholder: "How others see you" %>
        <p class="sd-account-hint">Shown in conversations instead of your login email.</p>
      </div>
      <div class="sd-account-field">
        <%= f.label :email, "Email" %>
        <%= f.email_field :email, class: "sd-account-input", autofocus: true,
          autocomplete: "email", required: true %>
      </div>
      <div class="sd-account-field">
        <%= f.label :password, "Password" %>
        <%= f.password_field :password, class: "sd-account-input", autocomplete: "new-password",
          required: true %>
        <% if @minimum_password_length %>
          <p class="sd-account-hint"><%= @minimum_password_length %> characters minimum.</p>
        <% end %>
      </div>
      <div class="sd-account-field">
        <%= f.label :password_confirmation, "Confirm password" %>
        <%= f.password_field :password_confirmation, class: "sd-account-input",
          autocomplete: "new-password", required: true %>
      </div>
    </div>
    <div class="sd-auth-avatar-field">
      <%= f.label :avatar, "Profile photo (optional)" %>
      <%= f.file_field :avatar, accept: "image/jpeg,image/png,image/webp" %>
      <p class="sd-auth-note">JPG, PNG or WebP up to 5 MB.</p>
    </div>
    <%= f.submit "Sign up", class: "sd-account-primary" %>
  <% end %>
  <div class="sd-auth-links">
    <%= render "devise/shared/links" %>
  </div>
</div>
