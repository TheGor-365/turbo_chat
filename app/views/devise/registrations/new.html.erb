<div class="sd-auth-page">
  <header class="sd-auth-heading">
    <span class="sd-account-section-icon"><%= sd_icon("user", size: 22) %></span>
    <h1><%= t("ui.auth.signup_title") %></h1>
    <p><%= t("ui.auth.signup_subtitle") %></p>
  </header>
  <%= render "devise/shared/feedback" %>
  <%= form_for(resource, as: resource_name, url: registration_path(resource_name),
    html: { class: "sd-auth-form" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>
    <div class="sd-account-fields">
      <div class="sd-account-field">
        <%= f.label :display_name, t("ui.auth.display_name") %>
        <%= f.text_field :display_name, class: "sd-account-input",
          maxlength: 48, autocomplete: "nickname", placeholder: t("ui.auth.display_name_placeholder"),
          aria: { invalid: resource.errors[:display_name].any?,
            describedby: (resource.errors[:display_name].any? ? "error_explanation" : nil) } %>
        <p class="sd-account-hint"><%= t("ui.auth.display_name_hint") %></p>
      </div>
      <div class="sd-account-field">
        <%= f.label :email, t("ui.auth.email") %>
        <%= f.email_field :email, class: "sd-account-input", autofocus: true,
          autocomplete: "email", required: true,
          aria: { invalid: resource.errors[:email].any?,
            describedby: (resource.errors[:email].any? ? "error_explanation" : nil) } %>
      </div>
      <div class="sd-account-field">
        <%= f.label :password, t("ui.auth.password") %>
        <%= f.password_field :password, class: "sd-account-input", autocomplete: "new-password",
          required: true,
          aria: { invalid: resource.errors[:password].any?,
            describedby: (resource.errors[:password].any? ? "error_explanation" : nil) } %>
        <% if @minimum_password_length %>
          <p class="sd-account-hint"><%= t("ui.auth.password_min", count: @minimum_password_length) %></p>
        <% end %>
      </div>
      <div class="sd-account-field">
        <%= f.label :password_confirmation, t("ui.auth.confirm_password") %>
        <%= f.password_field :password_confirmation, class: "sd-account-input",
          autocomplete: "new-password", required: true,
          aria: { invalid: resource.errors[:password_confirmation].any?,
            describedby: (resource.errors[:password_confirmation].any? ? "error_explanation" : nil) } %>
      </div>
    </div>
    <div class="sd-auth-avatar-field">
      <%= f.label :avatar, t("ui.auth.avatar") %>
      <%= f.file_field :avatar, accept: "image/jpeg,image/png,image/webp" %>
      <p class="sd-auth-note"><%= t("ui.auth.avatar_hint") %></p>
    </div>
    <%= f.submit t("ui.auth.signup_title"), class: "sd-account-primary" %>
  <% end %>
  <div class="sd-auth-links">
    <%= render "devise/shared/links" %>
  </div>
</div>
