<div class="container py-4">
  <div class="card p-3 p-md-4 my-4 mx-auto col-12 col-md-9 col-lg-7 bg-dark text-light border-secondary">
    <h2 class="text-light">Edit <%= resource_name.to_s.humanize %></h2>
  <section id="presence-privacy-settings" class="border border-secondary rounded p-3 mb-3" aria-labelledby="presence-privacy-title">
    <h3 id="presence-privacy-title" class="h6">Presence privacy</h3>
    <p class="small text-white-50 mb-2">
      You can appear offline in all direct conversations. Messages, typing and unread counts still work.
      This does not change other people's visibility.
    </p>
    <p class="small mb-2">Current setting: <strong><%= current_user.share_presence? ? "Show when active" : "Appear offline" %></strong></p>
    <%= form_with url: account_presence_path, method: :patch, local: true do |preference_form| %>
      <%= preference_form.hidden_field :share_presence, value: (!current_user.share_presence?).to_s %>
      <%= preference_form.submit(current_user.share_presence? ? "Appear offline" : "Show when active",
        class: "btn btn-sm btn-outline-light", id: "presence-visibility-toggle") %>
    <% end %>
  </section>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div class="py-3">
        <% if resource.avatar.attached? %>
          <%= image_tag user_avatar_path(resource), class: "rounded border border-secondary object-fit-cover", width: 96, height: 96, alt: "Your profile avatar" %>
        <% else %>
          <span class="d-inline-flex justify-content-center align-items-center rounded border border-secondary bg-secondary text-white" style="width: 96px; height: 96px;" role="img" aria-label="No profile photo">No photo</span>
        <% end %>
      </div>

      <div>
        <%= f.file_field :avatar, class:'form-control' %>
      </div>

      <div class="mt-3">
        <%= f.label :display_name, "Display name (optional)", class: "form-label" %>
        <%= f.text_field :display_name, class: "form-control", maxlength: 48,
          autocomplete: "nickname" %>
        <small class="text-white-50">Your public chat label. Account changes through this form require your current password.</small>
      </div>

      <div>
        <%= f.label :email, class: 'form-label' %><br />
        <%= f.email_field :email, autofocus: true, autocomplete: "email", class:'form-control' %>
      </div>

      <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
      <div>Currently waiting confirmation for: <%= resource.unconfirmed_email %></div>
      <% end %>

      <div class="mt-2">
        <%= f.label :password, class: 'form-label' %> <i>(leave blank if you don't want to change it)</i><br />
        <%= f.password_field :password, autocomplete: "new-password", class:'form-control' %>

        <small class="text-muted">
          <% if @minimum_password_length %>
            <%= @minimum_password_length %> characters minimum
          <% end %>
        </small>
      </div>

      <div class="mt-2">
        <%= f.label :password_confirmation, class: 'form-label' %><br />
        <%= f.password_field :password_confirmation, autocomplete: "new-password", class:'form-control' %>
      </div>

      <div class="mt-2">
        <%= f.label :current_password, class: 'form-label' %>
        <%= f.password_field :current_password, autocomplete: "current-password", class:'form-control' %>
        <small class="text-muted">
          need your current password to confirm your changes
        </small><br />
      </div>

      <div class="mt-3">
        <%= f.submit "Update", class: 'btn btn-success' %>
      </div>
    <% end %>
  </div>



  <h5 class="text-muted">Cancel my account</h5>
  <%= button_to "Cancel my account", registration_path(resource_name), method: :delete, class: 'btn btn-danger' %>
</div>
