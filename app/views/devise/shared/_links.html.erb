<%- if controller_name != 'sessions' %>
  <%= link_to t("ui.auth.login_title"), new_session_path(resource_name) %>
<% end %>

<%- if devise_mapping.registerable? && DemoAccessPolicy.signup_available? && controller_name != 'registrations' %>
  <%= link_to t("ui.auth.signup_title"), new_registration_path(resource_name) %>
<% end %>

<%- if devise_mapping.recoverable? && DemoAccessPolicy.password_recovery_available? && controller_name != 'passwords' && controller_name != 'registrations' %>
  <%= link_to t("ui.auth.forgot_title"), new_password_path(resource_name) %>
<% end %>

<%- if devise_mapping.confirmable? && controller_name != 'confirmations' %>
  <%= link_to t("ui.auth.confirmation_missing"), new_confirmation_path(resource_name) %>
<% end %>

<%- if devise_mapping.lockable? && resource_class.unlock_strategy_enabled?(:email) && controller_name != 'unlocks' %>
  <%= link_to t("ui.auth.unlock_missing"), new_unlock_path(resource_name) %>
<% end %>

<%- if devise_mapping.omniauthable? %>
  <%- resource_class.omniauth_providers.each do |provider| %>
    <%= link_to t("ui.auth.oauth_login", provider: OmniAuth::Utils.camelize(provider)), omniauth_authorize_path(resource_name, provider), method: :post %>
  <% end %>
<% end %>
