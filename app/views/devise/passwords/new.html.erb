<div class="sd-auth-page">
  <header class="sd-auth-heading">
    <span class="sd-account-section-icon"><%= sd_icon("lock", size: 22) %></span>
    <h1>Forgot your password?</h1>
    <p>Enter your account email to request reset instructions.</p>
  </header>
  <%= render "devise/shared/feedback" %>
  <%= form_for(resource, as: resource_name, url: password_path(resource_name),
    html: { method: :post, class: "sd-auth-form" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>
    <div class="sd-account-field">
      <%= f.label :email, "Email" %>
      <%= f.email_field :email, class: "sd-account-input", autofocus: true,
        autocomplete: "email", required: true %>
    </div>
    <%= f.submit "Send me reset password instructions", class: "sd-account-primary" %>
  <% end %>
  <div class="sd-auth-links"><%= render "devise/shared/links" %></div>
</div>
