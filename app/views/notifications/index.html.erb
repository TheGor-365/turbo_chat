<section id="notification-center" class="container py-4 text-light" aria-labelledby="notification-center-title">
  <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
    <div>
      <h1 id="notification-center-title" class="h4 mb-1">Activity &amp; chat history</h1>
      <p class="small text-white-50 mb-0">Activity records new-message alerts. Your full message history stays inside each conversation.</p>
    </div>
    <% if @unread_count.positive? %>
      <%= button_to "Mark all as read", read_all_notifications_path,
        method: :post, class: "btn btn-sm btn-outline-light" %>
    <% end %>
  </div>

  <% if @notifications.any? %>
    <ol class="list-unstyled mb-3" id="notification-list">
      <% @notifications.each do |notification| %>
        <li class="notification-item <%= 'notification-unread' if notification.read_at.nil? %>"
            data-notification-id="<%= notification.id %>"
            data-notification-unread="<%= notification.read_at.nil? %>">
          <div class="d-flex gap-2 flex-column">
            <strong class="small"><%= notification.room.direct_message? ? "Direct conversation" : notification.room.name %></strong>
            <span class="small"><%= notification.message.user.chat_label %> sent a message</span>
            <time class="small text-white-50" datetime="<%= notification.created_at.iso8601 %>">
              <%= time_ago_in_words(notification.created_at) %> ago
            </time>
          </div>
          <div class="d-flex align-items-center gap-2">
            <%= link_to "Open", room_path(notification.room, focus: notification.message_id),
              class: "btn btn-sm btn-outline-light", data: { turbo: false } %>
            <% if notification.read_at.nil? %>
              <%= button_to "Mark read", read_notification_path(notification),
                method: :post, class: "btn btn-sm btn-outline-secondary" %>
            <% end %>
          </div>
        </li>
      <% end %>
    </ol>
    <div class="notification-pagination"><%== pagy_nav(@pagy) if @pagy.pages > 1 %></div>
  <% else %>
    <div id="activity-empty" class="sd-activity-empty" role="status">
      <strong>No activity events recorded.</strong>
      <p>Messages you already sent or read aren't a notification archive. To review earlier messages, open a conversation under Chat history below.</p>
    </div>
  <% end %>
  <section id="conversation-history" class="sd-history-directory" aria-labelledby="chat-history-title">
    <h2 id="chat-history-title">Chat history</h2>
    <p class="small text-white-50 mb-2">Open a conversation to browse its messages or search within that chat. Only conversations you can currently access are listed.</p>

    <% if @history_direct_rooms.any? %>
      <h3>Private chats (1-to-1)</h3>
      <ul class="sd-history-directory__list">
        <% @history_direct_rooms.each do |room| %>
          <% peer = room.participants.find { |participant| participant.user_id != current_user.id }&.user %>
          <% if peer %>
            <li><%= link_to peer.chat_label, room_path(room), data: { turbo: false },
              aria: { label: "Open chat history with #{peer.chat_label}" } %></li>
          <% end %>
        <% end %>
      </ul>
    <% end %>

    <% if @history_private_group_rooms.any? %>
      <h3>Private groups</h3>
      <ul class="sd-history-directory__list">
        <% @history_private_group_rooms.each do |room| %>
          <li><%= link_to room.name, room_path(room), data: { turbo: false },
            aria: { label: "Open private group history in #{room.name}" } %></li>
        <% end %>
      </ul>
    <% end %>

    <% if @history_public_rooms.any? %>
      <h3>Joined public rooms</h3>
      <ul class="sd-history-directory__list">
        <% @history_public_rooms.each do |room| %>
          <li><%= link_to room.name, room_path(room), data: { turbo: false },
            aria: { label: "Open message history in #{room.name}" } %></li>
        <% end %>
      </ul>
    <% end %>

    <% if @history_direct_rooms.empty? && @history_public_rooms.empty? && @history_private_group_rooms.empty? %>
      <p class="small text-white-50 mb-0">No conversations yet. Find a person or join a public room to start one.</p>
    <% end %>
  </section>

  <%= link_to "Back to conversations", rooms_path, class: "small link-light" %>
</section>
