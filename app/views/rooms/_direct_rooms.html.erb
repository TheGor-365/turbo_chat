<% rooms.each do |room| %>
  <% peer = room.participants.find { |participant| participant.user_id != viewer.id }&.user %>
  <% if peer %>
    <%= link_to room_path(room), class: "list-group-item list-group-item-action bg-transparent text-light border-secondary d-flex justify-content-between align-items-center gap-2", data: { turbo: false } do %>
      <span class="sd-direct-identity"><%= sd_icon("user", size: 15) %>
        <span class="text-truncate" data-profile-label-user-id="<%= peer.id %>"><%= peer.chat_label %></span>
      </span>
      <% unread_count = (local_assigns[:unread_counts] || {}).fetch(room.id, 0) %>
      <% if unread_count.positive? %>
        <span class="badge rounded-pill text-bg-info" data-unread-room-id="<%= room.id %>"
              aria-label="<%= t("ui.room_list.unread_messages", count: unread_count) %>"><%= unread_count > 99 ? "99+" : unread_count %></span>
      <% end %>
    <% end %>
  <% end %>
<% end %>
