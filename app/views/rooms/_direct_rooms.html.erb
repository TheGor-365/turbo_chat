<% rooms.each do |room| %>
  <% peer = room.participants.find { |participant| participant.user_id != viewer.id }&.user %>
  <% if peer %>
    <%= link_to room_path(room), class: "list-group-item list-group-item-action bg-transparent text-light border-secondary d-flex justify-content-between align-items-center gap-2", data: { turbo: false } do %>
      <span class="text-truncate"><%= peer.email %></span>
      <small class="text-muted">Direct</small>
    <% end %>
  <% end %>
<% end %>
