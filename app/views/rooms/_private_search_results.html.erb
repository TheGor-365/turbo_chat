<% if rooms.any? %>
  <ul class="sd-room-search-matches list-unstyled mb-0" aria-label="Your matching private groups">
    <% rooms.each do |room| %>
      <li class="sd-room-search-match">
        <span class="sd-room-search-match__name" title="<%= room.name %>">
          <%= sd_icon("lock", size: 15) %>
          <span class="text-truncate"><%= room.name %></span>
        </span>
        <%= link_to room_path(room), class: "sd-room-search-match__open",
          title: "Open #{room.name}", aria: { label: "Open #{room.name}" },
          data: { turbo: false } do %>
          <%= sd_icon("arrow-up-right", size: 17) %>
        <% end %>
      </li>
    <% end %>
  </ul>
<% elsif params[:space] == "private" && params[:name_search].to_s.strip.length >= 2 %>
  <p class="small text-muted mb-0" role="status">No matching private groups in your memberships.</p>
<% end %>
