<% if rooms.any? %>
  <ul class="list-unstyled mb-0" aria-label="Available public rooms">
    <% rooms.each do |room| %>
      <li class="list-group-item d-flex align-items-center justify-content-between gap-2 room_list_item">
        <span class="text-truncate" title="<%= room.name %>"><%= room.name %></span>
        <%= button_to "Join", join_room_path(room), method: :post,
          class: "btn btn-sm btn-outline-light sd-room-join",
          form: { class: "d-inline-flex" },
          aria: { label: "Join #{room.name}" } %>
      </li>
    <% end %>
  </ul>
<% elsif params[:name_search].to_s.strip.length >= 2 %>
  <p class="small text-muted mb-0" role="status">No other public rooms match. Rooms you've joined are listed below.</p>
<% end %>
