<% if room.private_group? || current_user.has_joined_room(room) %>
  <%= button_to room.private_group? ? leave_private_group_path(room) : leave_room_path(room), method: :delete,
    class: "sd-room-leave",
    title: t("ui.room_list.leave_named", name: room.name),
    form: { class: "sd-room-leave-form", data: { turbo: false } },
    aria: { label: t("ui.room_list.leave_named", name: room.name) } do %>
    <%= sd_icon("log-out", size: 16) %>
  <% end %>
<% else %>
  <%= button_to t("ui.room_discovery.join"), join_room_path(room), method: :post,
    class: "btn btn-sm btn-outline-light sd-room-join",
    form: { class: "d-inline-flex" },
    aria: { label: t("ui.room_discovery.join_named", name: room.name) } %>
<% end %>
