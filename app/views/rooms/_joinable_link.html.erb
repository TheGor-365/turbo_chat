<% if current_user.has_joined_room(room) %>
  <%= button_to leave_room_path(room), method: :delete, class: "btn btn-link p-0", aria: { label: "Leave room" } do %>
    <i class="bi bi-dash-square room-leave-link-icon" aria-hidden="true"></i>
  <% end %>
<% else %>
  <%= button_to join_room_path(room), method: :post, class: "btn btn-link p-0", aria: { label: "Join room" } do %>
    <i class="bi bi-plus-square room-join-link-icon" aria-hidden="true"></i>
  <% end %>
<% end %>
