<% if room.is_private? %>
  <%# Direct messages cannot be joined or left through public-room actions. %>
<% elsif current_user.has_joined_room(room) %>
  <%= button_to leave_room_path(room), method: :delete, class: "btn btn-sm btn-outline-secondary", form: { data: { turbo_confirm: "Leave this room?" } }, aria: { label: "Leave #{room.name}" } do %>
    <i class="bi bi-dash-square" aria-hidden="true"></i> Leave
  <% end %>
<% else %>
  <%= button_to join_room_path(room), method: :post, class: "btn btn-sm btn-outline-primary", aria: { label: "Join #{room.name}" } do %>
    <i class="bi bi-plus-square" aria-hidden="true"></i> Join
  <% end %>
<% end %>
