<div id="room-notification-preference" class="room-notification-preference">
  <%= button_to muted ? "Unmute alerts" : "Mute alerts",
    room_notification_preference_path(room),
    method: :patch,
    params: { muted: (!muted).to_s },
    class: "btn btn-sm btn-outline-secondary room-mute-button",
    title: "Only in-app notification events are muted. Messages and unread counts are unchanged.",
    aria: {
      label: muted ? "Unmute incoming message notifications in this conversation" :
        "Mute incoming message notifications in this conversation"
    } %>
</div>
