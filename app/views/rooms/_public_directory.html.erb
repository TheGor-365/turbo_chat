<% if rooms.any? %>
  <ul class="sd-public-directory__list list-unstyled mb-0"
      aria-label="Public rooms available to join">
    <% rooms.each do |room| %>
      <li class="sd-public-directory__item">
        <span class="sd-public-directory__name" title="<%= room.name %>">
          <%= sd_icon("globe", size: 15) %><span><%= room.name %></span>
        </span>
        <%= button_to join_room_path(room), method: :post,
          class: "sd-icon-button sd-room-join",
          form: { class: "d-inline-flex" },
          title: "Join #{room.name}", aria: { label: "Join #{room.name}" } do %>
          <%= sd_icon("log-in", size: 16) %><span class="sd-visually-hidden">Join</span>
        <% end %>
      </li>
    <% end %>
  </ul>
  <% if rooms.length == 12 %>
    <p class="sd-public-directory__hint">Showing 12 rooms. Search by name for more.</p>
  <% end %>
  <p class="sd-public-directory__hint">Join a room to receive messages and unread alerts.</p>
<% else %>
  <p class="text-muted small mb-0" role="status">No other public rooms to join.</p>
<% end %>
