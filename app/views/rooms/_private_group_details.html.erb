<% memberships = room.participants.includes(:user).to_a %>
<% owner_member = memberships.find { |membership| membership.user_id == room.owner_id } %>
<details id="private-group-details" class="sd-private-group-details"
         data-controller="private-group-details"
         data-action="pointerdown@document->private-group-details#outside keydown.esc@document->private-group-details#escape"
         aria-label="<%= t("ui.group_popover.membership") %>">
  <summary class="sd-private-group-details__trigger"
           aria-label="<%= t("ui.group_popover.details", count: memberships.size) %>"
           title="<%= t("ui.group_popover.details", count: memberships.size) %>">
    <span class="sd-private-group-details__trigger-icon" aria-hidden="true"><%= sd_icon("users-round", size: 16) %></span>
    <span class="sd-private-group-details__count"><%= memberships.size %></span>
    <span class="sd-private-group-details__chevron" aria-hidden="true"><%= sd_icon("chevron-down", size: 14) %></span>
  </summary>
  <div class="sd-private-group-details__popover">
    <div class="sd-private-group-details__identity">
      <span class="sd-private-group-details__identity-mark" aria-hidden="true"><%= sd_icon("lock-keyhole", size: 18) %></span>
      <div class="sd-private-group-details__identity-copy">
        <strong><%= room.name %></strong>
        <small><%= t("ui.group_popover.invite_only") %></small>
      </div>
    </div>
    <dl class="sd-private-group-details__meta">
      <div>
        <dt><%= t("ui.group_popover.owner") %></dt>
        <dd><%= owner_member&.user&.chat_label || "—" %></dd>
      </div>
      <div>
        <dt><%= t("ui.group_popover.members") %></dt>
        <dd><%= memberships.size %></dd>
      </div>
    </dl>
    <div class="sd-private-group-details__heading">
      <strong><%= t("ui.group_popover.members") %></strong>
    </div>
    <% if flash[:private_group_invite_sent].present? %>
      <p class="sd-group-invite-feedback text-success small mb-2" role="status"><%= flash[:private_group_invite_sent] %></p>
    <% end %>
    <ul class="list-unstyled mb-0 sd-private-group-members">
      <% memberships.each do |membership| %>
        <li>
          <% if membership.user.avatar.attached? %>
            <%= image_tag user_avatar_path(membership.user), class: "sd-private-group-member-avatar",
              width: 28, height: 28, alt: "", loading: "lazy" %>
          <% else %>
            <span class="sd-private-group-member-avatar sd-private-group-member-avatar--initial" aria-hidden="true"><%= membership.user.chat_label.to_s.first.upcase %></span>
          <% end %>
          <span><%= membership.user.chat_label %> <%= "· #{t("ui.group_popover.owner")}" if membership.user_id == room.owner_id %></span>
          <% if room.owned_by?(current_user) && membership.user_id != room.owner_id %>
            <%= button_to t("ui.group_popover.remove"), remove_member_private_group_path(room, user_id: membership.user_id),
              method: :delete, class: "btn btn-sm sd-private-group-remove",
              form: { data: { turbo: false } },
              title: t("ui.group_popover.remove_title", name: membership.user.chat_label),
               aria: { label: t("ui.group_popover.remove_room", name: membership.user.chat_label, room: room.name) } %>
          <% end %>
        </li>
      <% end %>
    </ul>
    <% if room.owned_by?(current_user) && @group_invite_candidates.present? %>
      <%= form_with url: invite_private_group_path(room), method: :post,
        local: true, data: { turbo: false }, class: "sd-private-group-invite-form" do |form| %>
        <%= render "shared/signal_picker",
          id: "group-invite-user-#{room.id}", name: "user_id", label: t("ui.group_popover.invite_person"),
          icon: "user", selected: "", required: true,
          options: [[t("ui.group_popover.choose_member"), ""]] +
            @group_invite_candidates.map { |u| [u.chat_label, u.id.to_s] } %>
        <button type="submit" class="sd-icon-button sd-group-invite-submit"
                title="<%= t("ui.group_popover.send_invitation") %>" aria-label="<%= t("ui.group_popover.send_invitation") %>">
          <%= sd_icon("arrow-up-right", size: 18) %>
        </button>
      <% end %>
    <% end %>
  </div>
</details>
