<%= turbo_frame_tag "appearance_channel" %>
<div id="appearance_channel"></div>

<div id="chatroom_container" class="row bg-dark text-light ps-3">
  <div id="side_panel" class="col-md-4 col-sm-4"
       data-controller="inbox-sync" data-inbox-sync-url-value="<%= inbox_rooms_path %>"
       data-inbox-sync-filter-value="<%= @inbox_filter %>">
    <li class="list-group-item d-flex align-items-center justify-content-between user_list_item mb-5">
      <div class="icon-container">
        <% if current_user.avatar.attached? %>
          <%= link_to image_tag(user_avatar_path(current_user), class: "chat_pfp", alt: "Account settings"), edit_user_registration_path %>
        <% else %>
          <%= link_to current_user.email.first.upcase, edit_user_registration_path, class: "chat_pfp avatar-fallback d-inline-flex justify-content-center align-items-center text-decoration-none", aria: { label: "Account settings" } %>
        <% end %>
        <div>
          <%= render "users/status", user: current_user %>
        </div>
      </div>
      <div class="ms-2 me-auto username text-decoration-none text-muted">
        <%= current_user.email %>
      </div>
    </li>

    <h4 class="mb-3">Users</h4>
    <div id="users" class="mb-4">
      <% if @users.exists? %>
        <%= render @users %>
      <% else %>
        <p class="text-muted small">No other accounts yet. Create a second local test account to start a conversation.</p>
      <% end %>
    </div>

    <% inbox_all_path = @single_room ? room_path(@single_room) : rooms_path %>
    <% inbox_unread_path = @single_room ? room_path(@single_room, inbox: "unread") : rooms_path(inbox: "unread") %>
    <nav aria-label="Inbox filter" class="d-flex gap-2 mb-3" id="inbox-filters">
      <%= link_to "All", inbox_all_path,
        class: "btn btn-sm #{ @inbox_filter == 'all' ? 'btn-light' : 'btn-outline-light' }",
        aria: { current: (@inbox_filter == "all" ? "page" : nil) }, data: { turbo: false } %>
      <%= link_to "Unread", inbox_unread_path,
        class: "btn btn-sm #{ @inbox_filter == 'unread' ? 'btn-light' : 'btn-outline-light' }",
        aria: { current: (@inbox_filter == "unread" ? "page" : nil) }, data: { turbo: false } %>
    </nav>

    <h4 class="mb-3">Direct messages</h4>
    <div id="direct-rooms" class="mb-4">
      <%= render "rooms/inbox_direct" %>
    </div>

    <h4 class="mb-3">Chat Rooms</h4>

    <%= render 'layouts/new_room_form' %>
    <%= render 'rooms/search_form' %>
    <h6 class="text-muted mt-4">Chat Rooms list</h6>
    <div id="rooms" class="mt-3">
      <%= render "rooms/inbox_public" %>
    </div>
  </div>

  <div id="room_container" class="col-md-8 col-sm-8 bg-dark text-light">
    <% if @single_room %>
      <div id="single_room" data-controller="realtime-health room-read scroll<%= ' typing-indicator peer-presence' if @single_room.is_private? %>"
           data-typing-indicator-room-id-value="<%= @single_room.id %>"
           data-typing-indicator-user-id-value="<%= current_user.id %>"
           data-peer-presence-url-value="<%= presence_room_path(@single_room) if @single_room.is_private? %>"
           data-peer-presence-room-id-value="<%= @single_room.id %>"
           data-realtime-health-sync-url-value="<%= sync_room_messages_path(@single_room) %>"
           data-room-read-url-value="<%= read_room_path(@single_room) %>"
           data-room-read-room-id-value="<%= @single_room.id %>"
           data-room-read-history-focus-value="<%= @focused_message.present? %>"
           data-scroll-focus-message-id-value="<%= @focused_message&.id || 0 %>"
           data-scroll-latest-url-value="<%= room_path(@single_room) %>">
        <h4 class="text-center">
          <%= @conversation_title || @single_room.name %>
        </h4>
        <% if @single_room.is_private? %>
          <div class="peer-presence" role="status" aria-live="polite" aria-label="Conversation presence">
            <span class="peer-presence-dot" data-peer-presence-target="dot"
                  data-presence-state="unavailable" aria-hidden="true"></span>
            <span data-peer-presence-target="label">Presence unavailable</span>
          </div>
        <% end %>

        <%= turbo_stream_from @single_room, current_user, channel: "RoomMessagesChannel", data: { room_id: @single_room.id } %>
        <div class="realtime-health d-flex gap-2 align-items-center justify-content-end px-3"
             role="status" aria-live="polite">
          <span data-realtime-health-target="status">Connecting to live messages...</span>
          <button type="button" class="btn btn-sm btn-outline-light"
                  title="Sync messages without reloading"
                  data-action="realtime-health#sync"
                  data-realtime-health-target="syncButton"
                  aria-label="Sync messages">
            <i class="bi bi-arrow-clockwise" aria-hidden="true"></i>
          </button>
        </div>
        <%= render "messages/search_form", room: @single_room %>
        <% if @focused_message %>
          <div class="message-focus-banner" role="status">
            <div class="message-focus-context">
              <strong>Viewing an older message</strong>
              <span>You're in message history. Your latest conversation is one click away.</span>
            </div>
            <%= link_to "Return to latest messages", room_path(@single_room),
              class: "btn btn-sm btn-light message-focus-return",
              data: { turbo: false } %>
          </div>
        <% end %>
        <div id="messages" data-scroll-target="scroller">
          <%= turbo_frame_tag "page_handler" %>
          <%= render 'messages/pager', pagy: @pagy %>
          <div id="messages-container">
            <%= render partial: "messages/message", collection: @messages, as: :message, locals: { viewer: current_user } %>
          </div>
        </div>
        <%= link_to room_path(@single_room), class: "message-jump-latest",
          data: { scroll_target: "latestButton", action: "click->scroll#jumpToLatest", turbo: false },
          aria: { label: "Jump to latest messages" }, hidden: true do %>
          <span aria-hidden="true">↓</span>
          <span data-scroll-target="latestLabel">Latest messages</span>
        <% end %>
        <% if @single_room.is_private? %>
          <div id="typing-indicator" class="typing-indicator"
               data-typing-indicator-target="status"
               role="status" aria-live="polite" hidden></div>
        <% end %>
        <%= render 'layouts/new_message_form' %>
      </div>
    <% else %>
      <section id="empty-conversation" class="px-4 py-5" aria-labelledby="empty-conversation-title">
        <h2 id="empty-conversation-title" class="h5">Choose a conversation</h2>
        <p class="text-white-50">Select another user to start a private chat, or search for a public room to join.</p>
      </section>
    <% end %>
  </div>
</div>
