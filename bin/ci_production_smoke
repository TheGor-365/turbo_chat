#!/usr/bin/env bash
set -Eeuo pipefail

# Disposable GitHub Actions-only test. No Railway, local Compose, or owner data.
if [[ "${GITHUB_ACTIONS:-}" != "true" || -z "${RUNNER_TEMP:-}" || -z "${GITHUB_RUN_ID:-}" ]]; then
  echo "Refusing production smoke outside ephemeral GitHub Actions" >&2
  exit 1
fi
umask 077
image="turbo-chat:release-candidate"
network="relay-smoke-$GITHUB_RUN_ID-${GITHUB_RUN_ATTEMPT:-1}"
postgres="$network-postgres"
redis="$network-redis"
web="$network-web"
writer1="$network-writer-1"
writer2="$network-writer-2"
scratch="$(mktemp -d "$RUNNER_TEMP/relay-production-smoke.XXXXXX")"
private="$scratch/private"
mkdir -p "$private"

cleanup() {
  docker rm -f "$web" "$writer1" "$writer2" "$postgres" "$redis" >/dev/null 2>&1 || true
  docker network rm "$network" >/dev/null 2>&1 || true
}
trap cleanup EXIT

docker network create "$network" >/dev/null
docker run -d --name "$postgres" --network "$network" \
  -e POSTGRES_DB=turbo_chat_pro -e POSTGRES_PASSWORD=relay-ci-temporary-only \
  postgres:16-alpine >/dev/null
docker run -d --name "$redis" --network "$network" redis:7-alpine >/dev/null

for attempt in $(seq 1 40); do
  if docker exec "$postgres" pg_isready -U postgres -d turbo_chat_pro >/dev/null 2>&1 &&
     docker exec "$redis" redis-cli ping 2>/dev/null | grep -qx PONG; then break; fi
  sleep 2
done
docker exec "$postgres" pg_isready -U postgres -d turbo_chat_pro
docker exec "$redis" redis-cli ping | grep -qx PONG

# Runtime refuses to boot if the private volume is missing.
if docker run --rm -e RAILS_ENV=production "$image" true >"$scratch/unmounted.log" 2>&1; then
  echo "FAIL: production entrypoint accepted a missing volume" >&2
  exit 1
fi
grep -q 'Refusing boot' "$scratch/unmounted.log"

export SECRET_KEY_BASE
SECRET_KEY_BASE="$(openssl rand -hex 64)"
runtime_env=(
  -e RAILS_ENV=production -e RAILS_LOG_TO_STDOUT=1
  -e RAILS_SERVE_STATIC_FILES=1 -e RAILS_MAX_THREADS=5
  -e PGHOST="$postgres" -e PGUSER=postgres
  -e PGPASSWORD=relay-ci-temporary-only -e PGPORT=5432
  -e REDIS_URL="redis://$redis:6379/0"
  -e SECRET_KEY_BASE -e TURBO_CHAT_STORAGE_ROOT=/data/turbo-chat-private
  -e RAILWAY_VOLUME_MOUNT_PATH=/data/turbo-chat-private
  -e RAILWAY_VOLUME_NAME=ci-only-private-volume
  -e XAI_CONTEXT_REPLIES_ENABLED=0
)
mount_args=(-v "$private:/data/turbo-chat-private")

echo "Migrating a new empty temporary CI database in production mode"
docker run --rm --network "$network" "${runtime_env[@]}" "${mount_args[@]}" \
  "$image" bin/rails db:migrate

start_web() {
  docker run -d --name "$web" --network "$network" \
    -p 127.0.0.1::3000 "${runtime_env[@]}" "${mount_args[@]}" "$image" >/dev/null
  port="$(docker port "$web" 3000/tcp | awk -F: '{print $NF}')"
  [[ "$port" =~ ^[0-9]+$ ]]
  url="http://localhost:$port"
}
check_web() {
  local code=000
  for attempt in $(seq 1 45); do
    # Simulate TLS termination via forwarded header, NOT actual Railway TLS.
    code="$(curl -s --max-time 3 -o "$scratch/home.html" \
      -H 'X-Forwarded-Proto: https' -H 'Host: localhost' \
      -w '%{http_code}' "$url/" || true)"
    [[ "$code" == 200 ]] && break
    sleep 2
  done
  if [[ "$code" != 200 ]]; then
    echo "FAIL: production guest homepage HTTP $code" >&2
    docker logs --tail 80 "$web" >&2
    exit 1
  fi
  grep -Fq 'From conversation to an editable client brief.' "$scratch/home.html"
  grep -Fq 'Development release candidate only' "$scratch/home.html"

  code="$(curl -s --max-time 8 -o "$scratch/sign-in.html" \
    -H 'X-Forwarded-Proto: https' -H 'Host: localhost' \
    -w '%{http_code}' "$url/users/sign_in")"
  [[ "$code" == 200 ]] || { echo "FAIL: sign-in HTTP $code" >&2; exit 1; }

  # An unauthenticated URL guess must not disclose H5 content.
  code="$(curl -s --max-time 8 -o "$scratch/guest-export.html" \
    -H 'X-Forwarded-Proto: https' -H 'Host: localhost' \
    -w '%{http_code}' "$url/rooms/1/ai_deliverables/1/export.md?version=1")"
  [[ "$code" == 401 || "$code" == 302 || "$code" == 303 ]] ||
    { echo "FAIL: guest export HTTP $code" >&2; exit 1; }
  ! grep -Fq 'relay-ci-private-media' "$scratch/guest-export.html"
}

start_web
check_web

# Production R1 requires controlled-access sign-in. No public account creation
# or email reset is allowed until a separately verified SMTP/identity release.
check_restricted_access() {
  local code
  grep -Fq 'Controlled-access preview:' "$scratch/home.html"
  if grep -Fq '<span>Create account</span>' "$scratch/home.html"; then
    echo "FAIL: production guest home advertises unapproved signup" >&2
    exit 1
  fi

  for path in "/users/sign_up" "/users/password/new" \
      "/users/password/edit?reset_password_token=invalid-ci-token"; do
    code="$(curl --ipv4 -sS --max-time 12 -H 'X-Forwarded-Proto: https' \
      -o "$scratch/blocked-get.html" -w '%{http_code}' "$url$path")"
    [[ "$code" == 404 ]] || {
      echo "FAIL: production R1 unexpectedly exposes GET $path (HTTP $code)" >&2
      exit 1
    }
  done

  curl --ipv4 -sS --max-time 12 -H 'X-Forwarded-Proto: https' \
    -c "$scratch/restricted.cookies" -o "$scratch/restricted-sign-in.html" \
    "$url/users/sign_in"
  local csrf
  csrf="$(python3 - "$scratch/restricted-sign-in.html" <<'PY'
from html.parser import HTMLParser
import sys

class FormToken(HTMLParser):
    token = None
    def handle_starttag(self, tag, attrs):
        a = dict(attrs)
        if tag == "input" and a.get("name") == "authenticity_token":
            self.token = a.get("value")
parser = FormToken()
with open(sys.argv[1], encoding="utf-8") as page:
    parser.feed(page.read())
print(parser.token or "")
PY
)"
  [[ -n "$csrf" ]] || { echo "FAIL: no guest CSRF token for restricted gate test" >&2; exit 1; }

  for path in "/users" "/users/password"; do
    code="$(curl --ipv4 -sS --max-time 15 -b "$scratch/restricted.cookies" \
      -H 'X-Forwarded-Proto: https' \
      -H "X-CSRF-Token: $csrf" \
      --data-urlencode "authenticity_token=$csrf" \
      --data-urlencode 'user[email]=relay-ci-unauthorized-signup@example.test' \
      --data-urlencode 'user[password]=RestrictedCIOnlyPassword123!' \
      --data-urlencode 'user[password_confirmation]=RestrictedCIOnlyPassword123!' \
      -o "$scratch/blocked-post.html" -w '%{http_code}' "$url$path")"
    [[ "$code" == 404 ]] || {
      echo "FAIL: production R1 unexpectedly accepts POST $path (HTTP $code)" >&2
      exit 1
    }
  done
  echo "Production restricted signup and email recovery HTTP gates: PASS"
}
check_restricted_access

# Synthetic role matrix in production mode through real cookie-backed HTTP.
# Nothing here ever uses owner-local identities or persists beyond the CI runner.
echo "Preparing synthetic owner/member/outsider and private H5 + attachment"
export RELAY_SMOKE_PASSWORD
RELAY_SMOKE_PASSWORD="$(openssl rand -hex 24)"
docker run -i --rm --network "$network" "${runtime_env[@]}" "${mount_args[@]}" \
  -e RELAY_SMOKE_PASSWORD "$image" bin/rails runner - >"$scratch/fixture.env" <<'RUBY'
require "digest"
require "stringio"

password = ENV.fetch("RELAY_SMOKE_PASSWORD")
people = %w[owner member outsider].to_h do |name|
  email = "relay-ci-#{name}@example.test"
  [name, User.create!(email: email, password: password,
    password_confirmation: password, display_name: "CI #{name.capitalize}")]
end
room = Room.create!(name: "CI protected room", kind: "private_group",
  is_private: true, owner: people.fetch("owner"))
%w[owner member].each do |role|
  person = people.fetch(role)
  room.participants.create!(user: person, group_role: role == "owner" ? "owner" : "member")
  AiRoomContextConsent.find_or_initialize_by(room: room, user: person).grant!
end
message = room.messages.create!(user: people.fetch("member"), body: "CI source note")
message.attachments.attach(io: StringIO.new("relay-ci-secret-attachment\n"),
  filename: "ci-secret-note.txt", content_type: "text/plain")
raise "attachment not persisted" unless message.attachments.attached?
body = "## Objective\n- relay-ci-private-h5 [M#{message.id}]\n" \
  "## Requirements\n- Verify production access boundaries\n"
document = AiDeliverable.create!(room: room, owner: people.fetch("owner"),
  kind: "client_brief", state: "draft")
document.revisions.create!(author: people.fetch("owner"), version: 1,
  body_markdown: body, body_sha256: Digest::SHA256.hexdigest(body),
  source_message_ids: [message.id])
puts "room_id=#{room.id}"
puts "document_id=#{document.id}"
puts "attachment_id=#{message.attachments.first.id}"
RUBY
room_id="$(sed -n 's/^room_id=//p' "$scratch/fixture.env" | tail -1)"
document_id="$(sed -n 's/^document_id=//p' "$scratch/fixture.env" | tail -1)"
attachment_id="$(sed -n 's/^attachment_id=//p' "$scratch/fixture.env" | tail -1)"
for id in "$room_id" "$document_id" "$attachment_id"; do
  [[ "$id" =~ ^[1-9][0-9]*$ ]] || { echo "Invalid CI fixture ID" >&2; exit 1; }
done

login_as() {
  local role="$1"
  local jar="$scratch/$role.cookies" page="$scratch/$role-login.html"
  curl --ipv4 -sS --max-time 10 -c "$jar" \
    -H 'X-Forwarded-Proto: https' \
    -o "$page" "$url/users/sign_in"
  local csrf
  csrf="$(python3 - "$page" <<'PY'
from html.parser import HTMLParser
import sys
class TokenParser(HTMLParser):
    token = None
    def handle_starttag(self, tag, attrs):
        if tag == "input":
            values = dict(attrs)
            if values.get("name") == "authenticity_token":
                self.token = values.get("value")
parser = TokenParser()
with open(sys.argv[1], encoding="utf-8") as page:
    parser.feed(page.read())
print(parser.token or "")
PY
)"
  [[ -n "$csrf" ]] || { echo "No CSRF token for $role" >&2; exit 1; }
  local code
  code="$(curl --ipv4 -sS --max-time 15 -b "$jar" -c "$jar" \
    -H 'X-Forwarded-Proto: https' \
    --data-urlencode "authenticity_token=$csrf" \
    --data-urlencode "user[email]=relay-ci-$role@example.test" \
    --data-urlencode "user[password]=$RELAY_SMOKE_PASSWORD" \
    -o "$scratch/$role-login-result.html" -w '%{http_code}' "$url/users/sign_in")"
  [[ "$code" == 302 || "$code" == 303 ]] ||
    { echo "Production sign-in rejected $role: HTTP $code" >&2; exit 1; }
  code="$(curl --ipv4 -sS --max-time 12 -b "$jar" \
    -H 'X-Forwarded-Proto: https' \
    -o "$scratch/$role-home.html" -w '%{http_code}' "$url/")"
  [[ "$code" == 200 ]] && grep -Fq 'Pick up where you left off.' "$scratch/$role-home.html" ||
    { echo "Session cookie was not accepted for $role: HTTP $code" >&2; exit 1; }
}

request_as() {
  local role="$1" path="$2" output="$3"
  curl --ipv4 -sS --max-time 15 -b "$scratch/$role.cookies" \
    -H 'X-Forwarded-Proto: https' -o "$scratch/$output" \
    -w '%{http_code}' "$url$path"
}

login_as owner
login_as member
login_as outsider

h5="/rooms/$room_id/ai_deliverables/$document_id/export.md?version=1"
media="/chat-attachments/$attachment_id"
code="$(request_as owner "$h5" owner-h5.md)"
[[ "$code" == 200 ]] && grep -Fq 'relay-ci-private-h5' "$scratch/owner-h5.md" ||
  { echo "Owner cannot export production H5 HTTP $code" >&2; exit 1; }
code="$(request_as member "$h5" member-h5.html)"
[[ "$code" == 404 ]] && ! grep -Fq 'relay-ci-private-h5' "$scratch/member-h5.html" ||
  { echo "Non-owner member accessed private H5 HTTP $code" >&2; exit 1; }
code="$(request_as outsider "$h5" outsider-h5.html)"
[[ "$code" == 403 ]] && ! grep -Fq 'relay-ci-private-h5' "$scratch/outsider-h5.html" ||
  { echo "Outsider accessed private H5 HTTP $code" >&2; exit 1; }

for role in owner member; do
  code="$(request_as "$role" "$media" "$role-media.txt")"
  [[ "$code" == 200 ]] && grep -Fq 'relay-ci-secret-attachment' "$scratch/$role-media.txt" ||
    { echo "$role could not download permitted media HTTP $code" >&2; exit 1; }
done
code="$(request_as outsider "$media" outsider-media.html)"
[[ "$code" == 404 ]] && ! grep -Fq 'relay-ci-secret-attachment' "$scratch/outsider-media.html" ||
  { echo "Outsider accessed private attachment HTTP $code" >&2; exit 1; }

# Live consent revocation must instantly block previously readable private H5.
docker run --rm --network "$network" "${runtime_env[@]}" "${mount_args[@]}" \
  -e RELAY_SMOKE_ROOM_ID="$room_id" "$image" bin/rails runner '
    member = User.find_by!(email: "relay-ci-member@example.test")
    consent = AiRoomContextConsent.find_by!(room_id: ENV.fetch("RELAY_SMOKE_ROOM_ID").to_i,
      user_id: member.id)
    consent.revoke!
  '
code="$(request_as owner "$h5" owner-after-revoke.html)"
[[ "$code" == 403 ]] && ! grep -Fq 'relay-ci-private-h5' "$scratch/owner-after-revoke.html" ||
  { echo "Revoked room consent did not deny H5 HTTP $code" >&2; exit 1; }

docker run --rm --network "$network" "${runtime_env[@]}" "${mount_args[@]}" \
  -e RELAY_SMOKE_ROOM_ID="$room_id" \
  "$image" bin/rails runner '
    member = User.find_by!(email: "relay-ci-member@example.test")
    AiRoomContextConsent.find_by!(room_id: ENV.fetch("RELAY_SMOKE_ROOM_ID").to_i,
      user_id: member.id).grant!
  '
code="$(request_as owner "$h5" owner-restored.md)"
[[ "$code" == 200 ]] && grep -Fq 'relay-ci-private-h5' "$scratch/owner-restored.md" ||
  { echo "Restored consent did not allow owner export HTTP $code" >&2; exit 1; }
echo "Production HTTP sessions, role isolation, private media and consent revocation: PASS"

echo "Creating synthetic private Active Storage media in production mode"
docker run --rm --network "$network" "${runtime_env[@]}" "${mount_args[@]}" \
  "$image" bin/rails runner '
  require "stringio"
  body = "relay-ci-private-media\n"
  blob = ActiveStorage::Blob.create_and_upload!(
    io: StringIO.new(body), filename: "release-smoke-private.txt",
    content_type: "text/plain"
  )
  raise "private media write failed" unless blob.download == body
  puts "Production private media write: PASS"
'

# Replace the web container, reusing only disposable CI database and mount.
docker rm -f "$web" >/dev/null
start_web
check_web
docker run --rm --network "$network" "${runtime_env[@]}" "${mount_args[@]}" \
  "$image" bin/rails runner '
  blob = ActiveStorage::Blob.find_by!(filename: "release-smoke-private.txt")
  raise "private media lost after replacement" unless blob.download == "relay-ci-private-media\n"
  puts "Private media survived container replacement: PASS"
'
echo "Production boot, guest access boundaries and media persistence: PASS"

# Two real, independent production-mode Rails processes commit message records
# before pausing just ahead of their private media attachment writes. The
# database is intentionally ahead of the media tree at this point.
echo "Staging two concurrent synthetic DB/media writes before quiescence"
for n in 1 2; do
  writer_var="writer$n"
  docker run -d --name "${!writer_var}" --network "$network" \
    "${runtime_env[@]}" "${mount_args[@]}" \
    -e RELAY_CI_SYNTHETIC_WRITER=1 \
    -e RELAY_CI_WRITER_ID="$n" \
    -e RELAY_CI_ROOM_ID="$room_id" \
    "$image" bin/rails runner script/ci_concurrent_media_writer.rb >/dev/null
done

# Runner may not own the app's private volume (uid 1000). Use a strictly
# isolated helper to check the two marker paths instead of host user reads.
for attempt in $(seq 1 50); do
  if docker run --rm --network none --user 0:0 \
    -v "$private:/source:ro" --entrypoint bash "$image" \
    -c 'test -f /source/.ci-writer-active-1 && test -f /source/.ci-writer-active-2'; then
    break
  fi
  if [[ "$attempt" == 50 ]]; then
    docker logs --tail 30 "$writer1" >&2 || true
    docker logs --tail 30 "$writer2" >&2 || true
    echo "FAIL: two concurrent synthetic writers did not reach the barrier" >&2
    exit 1
  fi
  sleep 1
done
docker run --rm --network "$network" \
  "${runtime_env[@]}" "${mount_args[@]}" \
  -e RELAY_CI_ROOM_ID="$room_id" \
  "$image" bin/rails runner '
    room = Room.find(ENV.fetch("RELAY_CI_ROOM_ID").to_i)
    %w[1 2].each do |n|
      msg = room.messages.find_by!(body: "relay-ci-concurrent-write:#{n}")
      raise "Writer should be in the DB/media gap" if msg.attachments.attached?
    end
    puts "CI synthetic concurrent-write gap: two DB rows with pending media"
  '

# The app web server is stopped, but independent writer processes are still
# active. Even in this state backup MUST refuse the incoherent snapshot.
docker stop -t 10 "$web" >/dev/null
if bash bin/ci_backup_restore.sh "$postgres" "$private" "$image" \
    "$room_id" "$document_id" "$attachment_id" \
    >"$scratch/blocked-snapshot.log" 2>&1; then
  echo "FAIL: snapshot was accepted with active synthetic media writers" >&2
  exit 1
fi
grep -Fq "Refusing snapshot: synthetic CI writer still active" \
  "$scratch/blocked-snapshot.log" ||
  { echo "FAIL: snapshot refusal reason did not identify active writers" >&2; exit 1; }
echo "Fail-closed synthetic snapshot during DB/media race: PASS"

# Release BOTH real writer processes. Verify successful, fully completed
# PostgreSQL+Active Storage writes and no in-flight markers before snapshot.
docker run --rm --network none --user 0:0 \
  -v "$private:/target" --entrypoint touch "$image" \
  /target/.ci-writer-release
for n in 1 2; do
  writer_var="writer$n"
  writer_name="${!writer_var}"
  writer_exit="$(docker wait "$writer_name")"
  [[ "$writer_exit" == 0 ]] || {
    echo "FAIL: CI writer $n exited with $writer_exit" >&2
    docker logs --tail 60 "$writer_name" >&2 || true
    exit 1
  }
  docker rm "$writer_name" >/dev/null
done
docker run --rm --network none --user 0:0 \
  -v "$private:/target" --entrypoint bash "$image" -c \
  'test ! -e /target/.ci-writer-active-1 &&
   test ! -e /target/.ci-writer-active-2 &&
   rm -- /target/.ci-writer-release'
echo "Two concurrent synthetic writers drained successfully: PASS"

# Source app and all known synthetic write processes are stopped. This is a
# controlled CI-only quiescence protocol, not live Railway-write coordination.
bash bin/ci_backup_restore.sh "$postgres" "$private" "$image" \
  "$room_id" "$document_id" "$attachment_id"
